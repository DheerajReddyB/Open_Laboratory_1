// epwm_adc_polled_dump.c
// ePWM1 SOCA -> ADCA SOC0 -> polled capture -> RAM -> SCIA binary dump
// Polling style (no ISR, no DMA). Good for validating trigger/ADC/dump chain.
// Add DELAY before dump so host can open serial port.
//
// Paste into your CCS project (replace prior file if needed). Build & flash.
// Use serial capture that waits for header then saves bytes (robust_serial_capture.py recommended).
//
// Author: ChatGPT (adapted for F28379D)

#include <stdint.h>
#include <stdbool.h>
#include <string.h>

#include "F28x_Project.h"
#include "ti_ascii.h"

/* -------- CONFIGURATION -------- */
#define CAPTURE_SAMPLES   (1024U)     /* number of samples to collect */
#define ADC_CHANNEL       0x0EU       /* ADCIN14 */
#define DUMP_BAUDRATE     115200U

/* System / ePWM settings (tune TBPRD for sample rate) */
/* Typical: SYSCLK = 200 MHz, TBCLK_DIV = 4 -> TBCLK = 50 MHz */
#define SYSCLK_HZ         (200000000.0)
#define TBCLK_DIV         4U
/* For ePWM sample rate: sample_rate = (SYSCLK / TBCLK_DIV) / (TBPRD + 1)
   Default TBPRD set to 99 -> sample_rate = 50e6 / (99+1) = 500000 Hz (500 kS/s) */
#define TBPRD_DEFAULT     99U

/* ADC settings */
#define ADC_PRESCALE      6U    /* ADCCLK = SYSCLK / 4 when PRESCALE = 6 (typical) */
#define ADC_ACQPS         25U   /* sample window = ACQPS + 1 cycles (tune if needed) */

/* Delay before dumping (microseconds) -- helps host get ready; set to 0 if not needed */
#define PRE_DUMP_DELAY_US (2000000U)   /* 2 s */

/* ----------------- globals ----------------- */
static volatile uint16_t adcBuffer[CAPTURE_SAMPLES];
static volatile uint32_t sampleIndex = 0U;

/* Forward prototypes */
void initSCIA_blocking(uint32_t baud);
void scia_send_byte_blocking(unsigned char b);
void initSCIA_and_pins(uint32_t baud);

void initEPWM1_for_soctrig(uint32_t tbprd);
void initADC_for_epwm_soc0(void);

void dump_buffer_over_uart_with_header(uint32_t n);

/* ---------- SCIA helpers ---------- */
void initSCIA_blocking(uint32_t baud)
{
    EALLOW;
    SciaRegs.SCICCR.all = 0x0007;  /* 8-bit, 1 stop, no parity */
    SciaRegs.SCICTL1.all = 0x0003; /* release in reset later */
    SciaRegs.SCICTL2.bit.TXINTENA = 1;
    SciaRegs.SCICTL2.bit.RXBKINTENA = 1;
    EDIS;

    /* Baud calculation for LSPCLK = SYSCLK/TBCLK_DIV (we assume TBCLK_DIV typical) */
    /* Many examples use LSPCLK=50MHz when SYSCLK=200MHz and PRESCALE chosen accordingly */
    if (baud == 115200U) {
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = 53U;   /* approximate for 115200 @50MHz */
    } else if (baud == 921600U) {
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = 6U;    /* approximate */
    } else {
        uint32_t scil = (50000000UL / (16UL * baud));
        if (scil) scil -= 1U;
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = (uint16_t)scil;
    }

    /* Release SCI from reset */
    SciaRegs.SCICTL1.all = 0x0023;
}

void scia_send_byte_blocking(unsigned char b)
{
    SciaRegs.SCITXBUF.all = b;
    DELAY_US(200);
}

void initSCIA_and_pins(uint32_t baud)
{
    int rep;

    EALLOW;
    /* Route SCIA to GPIO42/43 (common on many F2837xD examples) */
    GpioCtrlRegs.GPBMUX1.bit.GPIO42  = 3;
    GpioCtrlRegs.GPBMUX1.bit.GPIO43  = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO42 = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO43 = 3;

    /* LED pin as output for visual indicator (GPIO31) */
    GpioCtrlRegs.GPADIR.bit.GPIO31 = 1;
    GpioDataRegs.GPADAT.bit.GPIO31 = 1; /* LED off */
    EDIS;

    initSCIA_blocking(baud);

    /* Triple HELLO for easy visual confirmation in terminal */
    {
        const char *hello = "HELLO\n";
        const char *p;
        for (rep = 0; rep < 3; ++rep) {
            p = hello;
            while (*p) scia_send_byte_blocking((unsigned char)*p++);
            DELAY_US(20000);
        }
    }
}

/* ---------- ePWM1 init: generate SOCA at TBPRD (up count) ---------- */
void initEPWM1_for_soctrig(uint32_t tbprd)
{
    EALLOW;
    /* Set time-base to up-count, no phase, prescalers = /1 */
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_COUNT_UP;
    EPwm1Regs.TBCTL.bit.PHSEN = TB_DISABLE;
    EPwm1Regs.TBCTL.bit.CLKDIV = TB_DIV1;     /* HSPCLK and CLKDIV set to 1 */
    EPwm1Regs.TBCTL.bit.HSPCLKDIV = TB_DIV1;
    EPwm1Regs.TBPRD = tbprd;

    /* Configure SOCA on zero event */
    EPwm1Regs.ETSEL.bit.SOCAEN = 1;
    EPwm1Regs.ETSEL.bit.SOCASEL = ET_CTR_ZERO; /* generate SOCA when counter zero */
    EPwm1Regs.ETPS.bit.SOCAPRD = ET_1ST;       /* first event */

    /* Leave counter stopped; start later by setting CTRMODE */
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_DISABLE;
    EDIS;
}

/* ---------- ADC init: route ADCA SOC0 to ADCIN14 and set ADCINT1 -> EOC0 ---------- */
void initADC_for_epwm_soc0(void)
{
    EALLOW;
    /* ADCCLK prescale */
    AdcaRegs.ADCCTL2.bit.PRESCALE = ADC_PRESCALE;
    AdcbRegs.ADCCTL2.bit.PRESCALE = ADC_PRESCALE;

    /* 12-bit single-ended */
    AdcSetMode(ADC_ADCA, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);
    AdcSetMode(ADC_ADCB, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);

    /* late sampling + power up */
    AdcaRegs.ADCCTL1.bit.INTPULSEPOS = 1;
    AdcaRegs.ADCCTL1.bit.ADCPWDNZ = 1;
    DELAY_US(1000); /* let ADC power up */

    /* SOC0 configuration */
    AdcaRegs.ADCSOC0CTL.bit.CHSEL = ADC_CHANNEL;
    AdcaRegs.ADCSOC0CTL.bit.ACQPS = ADC_ACQPS;

    /* TRIGSEL: ePWM1 SOCA mapping */
#ifdef ADCTRIG_EPWM1_SOCA
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = ADCTRIG_EPWM1_SOCA;
#elif defined(ADCTRIG1)
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = ADCTRIG1;
#else
    /* Fallback numeric mapping for ePWM1 SOCA (common value on many SDKs) */
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = 6U;
#endif

    /* Map ADCINT1 to be EOC0 so we can poll ADCINT1 after each SOC0 completes */
    AdcaRegs.ADCINTSEL1N2.bit.INT1SEL = 0; /* EOC0 */
    AdcaRegs.ADCINTSEL1N2.bit.INT1E = 1;
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;
    EDIS;
}

/* ---------- Dump buffer (binary) with ASCII header/footer ---------- */
void dump_buffer_over_uart_with_header(uint32_t n)
{
    const char *hdr = "CAPTURE_DONE\n";
    const char *p = hdr;
    while (*p) scia_send_byte_blocking((unsigned char)*p++);

    /* Brief LED toggle for visual indicator */
    GpioDataRegs.GPACLEAR.bit.GPIO31 = 1;
    DELAY_US(1000);
    GpioDataRegs.GPASET.bit.GPIO31 = 1;

    /* Send binary samples: LSB then MSB (little-endian) */
    uint32_t i;
    for (i = 0U; i < n; ++i) {
        uint16_t v = adcBuffer[i];
        scia_send_byte_blocking((unsigned char)(v & 0xFF));
        scia_send_byte_blocking((unsigned char)(v >> 8));
    }

    const char *endm = "\nCAPTURE_END\n";
    p = endm;
    while (*p) scia_send_byte_blocking((unsigned char)*p++);
}

/* ---------- main ---------- */
int main(void)
{
#ifdef _FLASH
    memcpy(&RamfuncsRunStart, &RamfuncsLoadStart, (size_t)&RamfuncsLoadSize);
#endif

    uint32_t i;
    uint32_t tbprd = TBPRD_DEFAULT;
    double tbclk = SYSCLK_HZ / (double)TBCLK_DIV;
    double sample_rate = tbclk / (double)(tbprd + 1U);

    /* Basic init */
    InitSysCtrl();
    DINT;
    InitPieCtrl();
    InitPieVectTable();

    /* SCIA + pins */
    initSCIA_and_pins(DUMP_BAUDRATE);

    /* ADC and ePWM init */
    initADC_for_epwm_soc0();
    initEPWM1_for_soctrig(tbprd);

    /* Announce start and sample-rate info */
    {
        char tbuf[128];
        int n = sprintf(tbuf, "CAPTURE_STARTED\n");
        for (i = 0; i < (uint32_t)n; ++i) scia_send_byte_blocking((unsigned char)tbuf[i]);
        n = sprintf(tbuf, "Using ePWM-derived sample rate: %.0f Hz (SYSCLK=%.0f, TBCLK_DIV=%u, TBPRD=%u)\n",
                    sample_rate, SYSCLK_HZ, TBCLK_DIV, tbprd);
        for (i = 0; i < (uint32_t)n; ++i) scia_send_byte_blocking((unsigned char)tbuf[i]);
    }

    /* Clear buffer/index */
    for (i = 0; i < CAPTURE_SAMPLES; ++i) adcBuffer[i] = 0;
    sampleIndex = 0U;

    /* Start ePWM counter (this will start generating SOCA triggers) */
    EALLOW;
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_COUNT_UP;
    EDIS;

    /* Capture loop: poll ADCINT1, read result, clear flag, store sample */
    while (sampleIndex < CAPTURE_SAMPLES) {
        /* Wait for conversion complete flag for SOC0 */
        while (AdcaRegs.ADCINTFLG.bit.ADCINT1 == 0) {
            /* busy-wait; could add timeout if desired */
        }

        /* Read result */
        uint16_t s = (uint16_t)AdcaResultRegs.ADCRESULT0;
        adcBuffer[sampleIndex++] = s;

        /* Clear ADCINT1 flag so next conversion sets it */
        AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;
    }

    /* Optionally stop ePWM (not necessary) */
    EALLOW;
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_DISABLE;
    EDIS;

    /* Give host time to be ready (avoid missed binary) */
    if (PRE_DUMP_DELAY_US) DELAY_US(PRE_DUMP_DELAY_US);

    /* Dump collected buffer */
    dump_buffer_over_uart_with_header(CAPTURE_SAMPLES);

    /* Halt here so you can inspect terminal */
    for (;;) { __asm(" NOP"); }

    return 0;
}
