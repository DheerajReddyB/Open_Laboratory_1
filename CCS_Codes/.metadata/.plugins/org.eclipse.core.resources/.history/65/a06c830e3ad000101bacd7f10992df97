// full_swtrigger_adc_test.c
// Minimal ADC debug: software-trigger ADC -> print 16 samples -> halt
// Use this ONLY to verify ADC + SCIA + board setup before doing ePWM capture.

#include <stdint.h>
#include <stdbool.h>
#include <stdio.h>
#include <string.h>

#include "F28x_Project.h"

/* ---------------- CONFIG ---------------- */
#define TEST_SAMPLES   16
#define ADC_CHANNEL    14      /* ADCIN14 */
/* ---------------------------------------- */

/* ------------- SCIA BLOCKING INIT ------------- */
void scia_send_byte_blocking(unsigned char b)
{
    SciaRegs.SCITXBUF.all = b;
    DELAY_US(150);  // needed for reliable first bytes
}

void initSCIA_blocking(uint32_t baud)
{
    EALLOW;

    // SCIA pins GPIO42=TX, GPIO43=RX
    GpioCtrlRegs.GPBMUX1.bit.GPIO42  = 3;
    GpioCtrlRegs.GPBMUX1.bit.GPIO43  = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO42 = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO43 = 3;

    // 8N1
    SciaRegs.SCICCR.all = 0x0007;

    // enable TX/RX
    SciaRegs.SCICTL1.all = 0x0003;

    // baud = 115200 @ LSPCLK=50 MHz
    SciaRegs.SCIHBAUD.all = 0;
    SciaRegs.SCILBAUD.all = 53;

    SciaRegs.SCICTL1.all = 0x0023;   // release from reset
    EDIS;
}

/* ------------ ADC INIT — SOFTWARE TRIGGER ------------- */
void initADC_swtrigger(void)
{
    EALLOW;

    // ADC clock prescale -> ADCCLK = SYSCLK/4 = 50 MHz
    AdcaRegs.ADCCTL2.bit.PRESCALE = 6;

    // 12-bit single-ended mode
    AdcSetMode(ADC_ADCA, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);

    // pulse interrupt at EOC
    AdcaRegs.ADCCTL1.bit.INTPULSEPOS = 1;

    // power up ADC
    AdcaRegs.ADCCTL1.bit.ADCPWDNZ = 1;
    DELAY_US(5000);      // <-- give full 5ms for safe power-up

    // SOC0 config: ADCIN14, ACQPS=20 cycles (safe)
    AdcaRegs.ADCSOC0CTL.bit.CHSEL = ADC_CHANNEL;
    AdcaRegs.ADCSOC0CTL.bit.ACQPS = 20;

    // TRIGSEL ignored because we will force SOC manually
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = 0;

    // INT1 = EOC0
    AdcaRegs.ADCINTSEL1N2.bit.INT1SEL = 0;
    AdcaRegs.ADCINTSEL1N2.bit.INT1E   = 1;

    // clear old flag
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

    // LED for activity
    GpioCtrlRegs.GPADIR.bit.GPIO31 = 1;
    GpioDataRegs.GPASET.bit.GPIO31 = 1;

    EDIS;
}

/* ---------------------- MAIN ---------------------- */
int main(void)
{
#ifdef _FLASH
    memcpy(&RamfuncsRunStart, &RamfuncsLoadStart, (size_t)&RamfuncsLoadSize);
#endif

    InitSysCtrl();
    DINT;
    InitPieCtrl();
    InitPieVectTable();

    initSCIA_blocking(115200);
    initADC_swtrigger();

    /* Print HELLO × 3 */
    {
        const char *h = "HELLO\n";
        for (int i = 0; i < 3; i++) {
            for (int j = 0; h[j]; j++) scia_send_byte_blocking(h[j]);
            DELAY_US(20000);
        }
    }

    /* INIT_DONE */
    {
        const char *msg = "INIT_DONE\n";
        for (int j = 0; msg[j]; j++) scia_send_byte_blocking(msg[j]);
    }

    DELAY_US(50000);

    /* ------------------ SOFTWARE TRIGGER TEST ------------------ */
    for (uint32_t n = 0; n < TEST_SAMPLES; n++)
    {
        // force SOC0
        AdcaRegs.ADCSOCFRC1.all = 0x1;

        // wait for ADCINT1
        uint32_t timeout = 0;
        while (AdcaRegs.ADCINTFLG.bit.ADCINT1 == 0)
        {
            DELAY_US(10);
            if (++timeout > 100000)
                break;     // 1 second timeout
        }

        uint16_t sample = (uint16_t)AdcaResultRegs.ADCRESULT0;
        AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

        // Print ASCII result
        char tb[32];
        int L = sprintf(tb, "TEST:%u\n", (unsigned)sample);
        for (int k = 0; k < L; k++)
            scia_send_byte_blocking(tb[k]);

        // LED toggle
        GpioDataRegs.GPATOGGLE.bit.GPIO31 = 1;

        DELAY_US(40000);   // slow down for readability
    }

    // Done message
    {
        const char *e = "SWTEST_DONE\n";
        for (int j = 0; e[j]; j++) scia_send_byte_blocking(e[j]);
    }

    // halt
    for (;;)
        asm(" NOP");
}
