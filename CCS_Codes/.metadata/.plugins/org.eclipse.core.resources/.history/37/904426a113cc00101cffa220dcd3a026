// ISRcapture_UARTdump_with_robust_scia.c
// ADC SOC0 triggered by ePWM1 SOCA -> ISR writes samples to RAM -> stop -> dump over SCIA (binary)
// Includes robust SCIA transmit (small per-byte delay) and triple "HELLO" startup test.
//
// Safe small buffer (no .cmd changes needed).
// Author: ChatGPT (updated for robust SCIA)

#include <stdint.h>
#include <stdbool.h>
#include <stdio.h>
#include <string.h>

#include "F28x_Project.h"
#include "ti_ascii.h"

// --------------- CONFIG ---------------
#define CAPTURE_SAMPLES      (4096U)     // 4k samples -> 8 KB RAM (uint16_t)
#define ADC_CHANNEL          0x0EU       // ADCIN14
#define EPWM_PERIOD_TICKS    99U         // TBPRD example for TBCLK=50MHz -> ~500 kS/s
#define DUMP_BAUDRATE        115200U     // SCIA dump baud (use 921600 if adapter supports)
// --------------------------------------

// volatile buffer written in ISR
static volatile uint16_t adcBuffer[CAPTURE_SAMPLES];
static volatile uint32_t sampleIndex = 0U;
static volatile bool capture_done = false;

/* Forward prototypes */
void initEPWM_for_trigger(void);
void initADC_for_SOC0_with_int(void);
void startCapture(void);
void initSCIA_blocking(uint32_t baud);
void initSCIA_and_pins(uint32_t baud);
void scia_send_byte_blocking(unsigned char b);
void dump_buffer_over_uart_with_header(void);

/* -------------------------
   ADC ISR - ADCA INT1 (EOC0)
   ------------------------- */
__interrupt void adca_isr(void)
{
    uint16_t s = (uint16_t)AdcaResultRegs.ADCRESULT0; // read ADC result

    if (sampleIndex < CAPTURE_SAMPLES) {
        adcBuffer[sampleIndex++] = s;
    }

    if (sampleIndex >= CAPTURE_SAMPLES) {
        /* stop ePWM triggers */
        EALLOW;
        EPwm1Regs.TBCTL.bit.CTRMODE = TB_FREEZE;
        EDIS;

        /* disable ADCINT1 */
        AdcaRegs.ADCINTSEL1N2.bit.INT1E = 0;
        capture_done = true;
    }

    /* clear ADCINT1 flag */
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

    /* acknowledge PIE group 1 (ADC) */
    PieCtrlRegs.PIEACK.all = PIEACK_GROUP1;
}

/* -------------------------
   EPWM config - generate SOCA
   ------------------------- */
void initEPWM_for_trigger(void)
{
    EALLOW;
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_FREEZE;
    EPwm1Regs.TBPRD = EPWM_PERIOD_TICKS;
    EPwm1Regs.TBCTL.bit.PHSEN = TB_DISABLE;
    EPwm1Regs.TBCTL.bit.CLKDIV = TB_DIV1;
    EPwm1Regs.TBCTL.bit.HSPCLKDIV = TB_DIV1;
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_COUNT_UP;

    EPwm1Regs.ETSEL.bit.SOCAEN = 1;
    EPwm1Regs.ETSEL.bit.SOCASEL = ET_CTR_ZERO;
    EPwm1Regs.ETPS.bit.SOCAPRD = ET_1ST;

    EPwm1Regs.TBCTL.bit.CTRMODE = TB_COUNT_UP;
    EDIS;
}

/* -------------------------
   ADC config (SOC0 -> ADCIN14, trigger by ePWM1 SOCA)
   ------------------------- */
void initADC_for_SOC0_with_int(void)
{
    EALLOW;

    AdcaRegs.ADCCTL2.bit.PRESCALE = 6;  // ADCCLK = SYSCLK/4
    AdcbRegs.ADCCTL2.bit.PRESCALE = 6;

    AdcSetMode(ADC_ADCA, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);
    AdcSetMode(ADC_ADCB, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);

    AdcaRegs.ADCCTL1.bit.INTPULSEPOS = 1;
    AdcaRegs.ADCCTL1.bit.ADCPWDNZ = 1;
    DELAY_US(1000);

    AdcaRegs.ADCSOC0CTL.bit.CHSEL = ADC_CHANNEL;
    AdcaRegs.ADCSOC0CTL.bit.ACQPS = 25U;

#ifdef ADCTRIG_EPWM1_SOCA
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = ADCTRIG_EPWM1_SOCA;
#else
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = 5U; /* numeric fallback */
#endif

    AdcaRegs.ADCINTSEL1N2.bit.INT1SEL = 0; /* EOC0 */
    AdcaRegs.ADCINTSEL1N2.bit.INT1E = 1;
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

    EDIS;
}

/* -------------------------
   SCIA init (blocking send helper)
   ------------------------- */
void initSCIA_blocking(uint32_t baud)
{
    EALLOW;

    /* 8-bit char, 1 stop bit, no parity */
    SciaRegs.SCICCR.all = 0x0007;

    /* Enable TX/RX */
    SciaRegs.SCICTL1.all = 0x0003;

    /* Enable SCI interrupts (not needed for blocking send) */
    SciaRegs.SCICTL2.bit.TXINTENA = 1;
    SciaRegs.SCICTL2.bit.RXBKINTENA = 1;

    /* Baud settings for typical LSPCLK = 50 MHz */
    if (baud == 115200U) {
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = 53U; /* approx */
    } else if (baud == 921600U) {
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = 6U;  /* approx */
    } else {
        uint32_t scil = (50000000UL / (16UL * baud));
        if (scil) scil -= 1;
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = (uint16_t)scil;
    }

    /* Relinquish SCI from reset */
    SciaRegs.SCICTL1.all = 0x0023;

    EDIS;
}

/* ---- Robust transmit + triple HELLO startup test ---- */

/* Robust blocking send: write byte, wait a short time for hardware to accept it.
   A tiny delay prevents lost-first-byte symptoms on some setups. */
void scia_send_byte_blocking(unsigned char b)
{
    SciaRegs.SCITXBUF.all = b;
    DELAY_US(200);   // 200 us delay for robustness during debug
}

/* Initialize SCIA pinmux and peripheral, then send HELLO three times to confirm reception. */
void initSCIA_and_pins(uint32_t baud)
{
    EALLOW;
    /* Route SCIA to GPIO42/43 (common on F28379D LaunchPad). Change if your board uses different pins. */
    GpioCtrlRegs.GPBMUX1.bit.GPIO42  = 3;
    GpioCtrlRegs.GPBMUX1.bit.GPIO43  = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO42 = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO43 = 3;

    /* Configure an LED pin as output for visual feedback (GPIO31 used earlier examples) */
    GpioCtrlRegs.GPADIR.bit.GPIO31 = 1;
    GpioDataRegs.GPADAT.bit.GPIO31 = 1;
    EDIS;

    /* Initialize SCIA peripheral */
    initSCIA_blocking(baud);

    /* Send HELLO three times with short gaps to confirm terminal receives full string */
    const char *hello = "HELLO\n";
    int repeat;
    for (repeat = 0; repeat < 3; ++repeat) {
        const char *p = hello;
        while (*p) {
            scia_send_byte_blocking((unsigned char)*p++);
        }
        DELAY_US(20000); /* 20 ms gap */
    }

    /* Optional: brief LED toggle */
    GpioDataRegs.GPACLEAR.bit.GPIO31 = 1;
    DELAY_US(10000);
    GpioDataRegs.GPASET.bit.GPIO31 = 1;
}

/* -------------------------
   Dump buffer over SCIA with ASCII header/footer
   ------------------------- */
void dump_buffer_over_uart_with_header(void)
{
    const char *hdr = "CAPTURE_DONE\n";
    const char *hp = hdr;
    while (*hp) {
        scia_send_byte_blocking((unsigned char)*hp++);
    }

    /* Toggle LED briefly as visual indicator */
    GpioDataRegs.GPACLEAR.bit.GPIO31 = 1;
    DELAY_US(1000);
    GpioDataRegs.GPASET.bit.GPIO31 = 1;

    /* Now send binary samples: LSB then MSB */
    {
        uint32_t i;
        uint16_t v;
        for (i = 0U; i < sampleIndex; ++i) {
            v = adcBuffer[i];
            scia_send_byte_blocking((unsigned char)(v & 0xFF));
            scia_send_byte_blocking((unsigned char)(v >> 8));
        }
    }

    const char *endm = "\nCAPTURE_END\n";
    const char *ep = endm;
    while (*ep) {
        scia_send_byte_blocking((unsigned char)*ep++);
    }
}

/* -------------------------
   Start capture: configure PIE, enable ADCA INT1 and TBCLKSYNC
   ------------------------- */
void startCapture(void)
{
    sampleIndex = 0U;
    capture_done = false;

    EALLOW;
    PieVectTable.ADCA1_INT = &adca_isr;
    EDIS;

    PieCtrlRegs.PIEIER1.bit.INTx1 = 1;   /* ADCA INT1 */

    EINT;   /* enable global interrupts */
    ERTM;

    EALLOW;
    CpuSysRegs.PCLKCR0.bit.TBCLKSYNC = 1; /* start ePWM timebase */
    EDIS;
}

/* -------------------------
   MAIN
   ------------------------- */
/* ---------- Replace only the main() function with this ---------- */
/* ---------- Replace only the main() function with this ---------- */
int main(void)
{
#ifdef _FLASH
    /* copy RAM functions if running from flash */
    memcpy(&RamfuncsRunStart, &RamfuncsLoadStart, (size_t)&RamfuncsLoadSize);
#endif

    /* Basic system setup */
    InitSysCtrl();
    DINT;
    InitPieCtrl();
    InitPieVectTable();

    /* Peripheral init */
    initEPWM_for_trigger();
    initADC_for_SOC0_with_int();

    /* Init SCIA pins + SCIA and send HELLO (already does triple HELLO) */
    initSCIA_and_pins(DUMP_BAUDRATE);

    /* --- DEBUG: announce capture start (sent before starting ePWM) --- */
    {
        const char *msg = "CAPTURE_STARTED\n";
        const char *p = msg;
        while (*p) scia_send_byte_blocking((unsigned char)*p++);
    }

    /* Start capture (enable interrupts and ePWM) */
    startCapture();

    /* Wait for capture end (set in ISR) */
    while (!capture_done) {
        __asm(" NOP");
    }

    /* Dump the captured buffer over UART (ASCII header + binary + footer) */
    dump_buffer_over_uart_with_header();

    /* Halt here */
    for (;;) { __asm(" NOP"); }
    return 0;
}
