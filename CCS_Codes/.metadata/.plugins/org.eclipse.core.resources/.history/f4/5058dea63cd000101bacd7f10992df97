// epwm_adc_trigger_debug.c
// Debug ePWM->ADCA trigger path: prints TRIGSEL, TBPRD, TBCTL, TBCTR, ADCINT1, ADCRESULT
// C89-friendly, ready to paste into a NEW CCS source file.

#include <stdint.h>
#include <stdbool.h>
#include <stdio.h>
#include <string.h>

#include "F28x_Project.h"
#include "ti_ascii.h"

/* Config */
#define ADC_CHANNEL    14U
#define DUMP_BAUDRATE  115200U
#define TBPRD_DEFAULT  99U
#define ADC_PRESCALE   6U
#define ADC_ACQPS      25U

/* Helpers */
void scia_send_byte_blocking(unsigned char b)
{
    SciaRegs.SCITXBUF.all = b;
    DELAY_US(150);
}

void scia_print(const char *s)
{
    const char *p = s;
    while (*p) scia_send_byte_blocking((unsigned char)*p++);
}

void scia_printf(const char *fmt, unsigned int a, unsigned int b, unsigned int c, unsigned int d)
{
    char buf[128];
    int n = sprintf(buf, fmt, a, b, c, d);
    int i;
    for (i = 0; i < n; ++i) scia_send_byte_blocking((unsigned char)buf[i]);
}

void initSCIA_blocking(uint32_t baud)
{
    EALLOW;
    /* route SCIA to GPIO42/43 */
    GpioCtrlRegs.GPBMUX1.bit.GPIO42  = 3;
    GpioCtrlRegs.GPBMUX1.bit.GPIO43  = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO42 = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO43 = 3;
    EDIS;

    SciaRegs.SCICCR.all = 0x0007;
    SciaRegs.SCICTL1.all = 0x0003;
    if (baud == 115200U) { SciaRegs.SCIHBAUD.all = 0; SciaRegs.SCILBAUD.all = 53; }
    else { SciaRegs.SCIHBAUD.all = 0; SciaRegs.SCILBAUD.all = 53; }
    SciaRegs.SCICTL1.all = 0x0023;
}

/* ADC init (SOC0 -> ADCIN14) */
void initADC_for_epwm_soc0(void)
{
    EALLOW;
    AdcaRegs.ADCCTL2.bit.PRESCALE = ADC_PRESCALE;
    AdcbRegs.ADCCTL2.bit.PRESCALE = ADC_PRESCALE;

    AdcSetMode(ADC_ADCA, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);
    AdcSetMode(ADC_ADCB, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);

    AdcaRegs.ADCCTL1.bit.INTPULSEPOS = 1;
    AdcaRegs.ADCCTL1.bit.ADCPWDNZ = 1;
    DELAY_US(1000);

    AdcaRegs.ADCSOC0CTL.bit.CHSEL = ADC_CHANNEL;
    AdcaRegs.ADCSOC0CTL.bit.ACQPS = ADC_ACQPS;

    /* TRIGSEL: prefer symbolic ADCTRIG_EPWM1_SOCA; fallback numeric */
#ifdef ADCTRIG_EPWM1_SOCA
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = ADCTRIG_EPWM1_SOCA;
#elif defined(ADCTRIG1)
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = ADCTRIG1;
#else
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = 6U; /* common fallback for many SDKs */
#endif

    AdcaRegs.ADCINTSEL1N2.bit.INT1SEL = 0; /* EOC0 */
    AdcaRegs.ADCINTSEL1N2.bit.INT1E = 1;
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;
    EDIS;
}

/* ePWM1 init for SOCA on counter-zero */
void initEPWM1_for_soctrig(uint32_t tbprd)
{
    EALLOW;
    EPwm1Regs.TBCTL.bit.CLKDIV = TB_DIV1;
    EPwm1Regs.TBCTL.bit.HSPCLKDIV = TB_DIV1;
    EPwm1Regs.TBCTL.bit.PHSEN = TB_DISABLE;
    EPwm1Regs.TBPRD = tbprd;

    EPwm1Regs.ETSEL.bit.SOCAEN = 1;
    EPwm1Regs.ETSEL.bit.SOCASEL = ET_CTR_ZERO;
    EPwm1Regs.ETPS.bit.SOCAPRD = ET_1ST;

    EPwm1Regs.TBCTL.bit.CTRMODE = TB_DISABLE; /* leave stopped */
    EDIS;
}

int main(void)
{
#ifdef _FLASH
    memcpy(&RamfuncsRunStart, &RamfuncsLoadStart, (size_t)&RamfuncsLoadSize);
#endif

    uint32_t tbprd = TBPRD_DEFAULT;
    uint32_t iter;
    uint32_t tbctr_val;
    uint32_t trigsel_val;
    uint32_t adcint1;
    uint32_t adcres;

    /* basic init */
    InitSysCtrl();
    DINT;
    InitPieCtrl();
    InitPieVectTable();

    initSCIA_blocking(DUMP_BAUDRATE);
    /* HELLO x3 */
    scia_print("HELLO\n"); DELAY_US(20000);
    scia_print("HELLO\n"); DELAY_US(20000);
    scia_print("HELLO\n"); DELAY_US(20000);

    scia_print("INIT_DONE\n");

    /* init ADC and ePWM (but don't start EPWM yet) */
    initADC_for_epwm_soc0();
    initEPWM1_for_soctrig(tbprd);

    scia_print("CAPTURE_STARTED\n");

    /* Print register snapshot before starting ePWM */
    /* read TRIGSEL (bitfield) via bit access */
    trigsel_val = (uint32_t)AdcaRegs.ADCSOC0CTL.bit.TRIGSEL;
    tbctr_val = (uint32_t)EPwm1Regs.TBCTR;
    /* TBPRD */
    scia_printf("PREDBG TRIGSEL=%u TBPRD=%u TBCTR=%u\n", trigsel_val, (unsigned int)EPwm1Regs.TBPRD, (unsigned int)tbctr_val, 0);

    /* Also print ETSEL.SOCAEN and ETSEL.SOCASEL */
    scia_printf("PREDBG EPwm1.ETSEL.SOCAEN=%u SOCASEL=%u\n",
                (unsigned int)EPwm1Regs.ETSEL.bit.SOCAEN,
                (unsigned int)EPwm1Regs.ETSEL.bit.SOCASEL,
                0, 0);

    /* Start ePWM counter so it generates SOCA */
    EALLOW;
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_COUNT_UP;
    EDIS;

    /* Short debug loop: print TBCTR, TRIGSEL, ADCINT1, ADCRESULT0 repeatedly */
    for (iter = 0; iter < 200; ++iter) {
        tbctr_val = (uint32_t)EPwm1Regs.TBCTR;
        trigsel_val = (uint32_t)AdcaRegs.ADCSOC0CTL.bit.TRIGSEL;
        adcint1 = (uint32_t)AdcaRegs.ADCINTFLG.bit.ADCINT1;
        adcres = (uint32_t)AdcaResultRegs.ADCRESULT0;

        scia_printf("DBG TBCTR=%u TRIGSEL=%u ADCINT1=%u ADCRES=%u\n",
                    tbctr_val, trigsel_val, adcint1, adcres);

        /* If ADCINT1 is set, print a special message */
        if (adcint1) {
            scia_print("DBG: ADCINT1 IS SET (conversion happened)\n");
            /* Clear it so we can observe subsequent sets */
            AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;
        }

        DELAY_US(5000); /* 5 ms between debug lines */
    }

    /* Stop EPWM */
    EALLOW;
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_DISABLE;
    EDIS;

    scia_print("DBG_DONE\n");

    /* Halt so you can inspect terminal */
    for (;;) __asm(" NOP");
    return 0;
}
