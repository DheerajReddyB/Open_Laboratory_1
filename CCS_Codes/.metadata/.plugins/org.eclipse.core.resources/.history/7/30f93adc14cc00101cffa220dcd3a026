// debug_swtrigger_capture.c
// Software-trigger ADC capture -> RAM -> UART dump (binary) for debugging ePWM/trigger issues.
// Self-contained: does not use ePWM or PIE/ISR for capture; forces SOC0 in a loop and polls ADCINT1.
//
// Author: ChatGPT
// Usage: paste into CCS project, build, flash. Open serial terminal (COM, 115200, 8N1, Flow control=None)
// You should see HELLO, CAPTURE_STARTED, then CAPTURE_DONE and binary dump + CAPTURE_END.

#include <stdint.h>
#include <stdbool.h>
#include <stdio.h>
#include <string.h>

#include "F28x_Project.h"
#include "ti_ascii.h"

#define CAPTURE_SAMPLES   (1024U)   // smaller for debug (2 KB). Increase later if needed.
#define ADC_CHANNEL       0x0EU     // ADCIN14
#define DUMP_BAUDRATE     115200U

/* Buffer and indices */
static volatile uint16_t adcBuffer[CAPTURE_SAMPLES];
static volatile uint32_t sampleIndex = 0U;

/* Prototypes (re-using helpers from previous code) */
void initSCIA_blocking(uint32_t baud);
void initSCIA_and_pins(uint32_t baud);
void scia_send_byte_blocking(unsigned char b);
void dump_buffer_over_uart_with_header(void);
void initADC_for_SOC0_for_software_trigger(void);

/* ----- SCIA helper code (same robust transmit as before) ----- */
void initSCIA_blocking(uint32_t baud)
{
    EALLOW;
    SciaRegs.SCICCR.all = 0x0007;    /* 8-bit, 1 stop, no parity */
    SciaRegs.SCICTL1.all = 0x0003;   /* enable TX/RX */
    SciaRegs.SCICTL2.bit.TXINTENA = 1;
    SciaRegs.SCICTL2.bit.RXBKINTENA = 1;
    if (baud == 115200U) {
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = 53U;
    } else {
        uint32_t scil = (50000000UL / (16UL * baud));
        if (scil) scil -= 1;
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = (uint16_t)scil;
    }
    SciaRegs.SCICTL1.all = 0x0023; /* release SCI from reset */
    EDIS;
}

/* robust send: small debug delay to avoid lost-first-byte symptoms */
void scia_send_byte_blocking(unsigned char b)
{
    SciaRegs.SCITXBUF.all = b;
    DELAY_US(200);
}

/* SCIA pin mux + triple HELLO */
void initSCIA_and_pins(uint32_t baud)
{
    EALLOW;
    GpioCtrlRegs.GPBMUX1.bit.GPIO42  = 3;
    GpioCtrlRegs.GPBMUX1.bit.GPIO43  = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO42 = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO43 = 3;
    /* LED pin for visual feedback */
    GpioCtrlRegs.GPADIR.bit.GPIO31 = 1;
    GpioDataRegs.GPADAT.bit.GPIO31 = 1;
    EDIS;

    initSCIA_blocking(baud);
    const char *hello = "HELLO\n";
    for (int r=0;r<3;++r) {
        const char *p = hello;
        while (*p) scia_send_byte_blocking((unsigned char)*p++);
        DELAY_US(20000);
    }
}

/* dump buffer with header/footer (same format used earlier) */
void dump_buffer_over_uart_with_header(void)
{
    const char *hdr = "CAPTURE_DONE\n";
    const char *p = hdr;
    while (*p) scia_send_byte_blocking((unsigned char)*p++);
    /* send binary samples */
    uint32_t i;
    for (i = 0; i < sampleIndex; ++i) {
        uint16_t v = adcBuffer[i];
        scia_send_byte_blocking((unsigned char)(v & 0xFF));
        scia_send_byte_blocking((unsigned char)(v >> 8));
    }
    const char *endm = "\nCAPTURE_END\n";
    p = endm;
    while (*p) scia_send_byte_blocking((unsigned char)*p++);
}

/* ----- ADC init for SOC0 (software trigger) ----- */
void initADC_for_SOC0_for_software_trigger(void)
{
    EALLOW;
    AdcaRegs.ADCCTL2.bit.PRESCALE = 6;      /* ADCCLK = SYSCLK/4 */
    AdcbRegs.ADCCTL2.bit.PRESCALE = 6;

    AdcSetMode(ADC_ADCA, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);
    AdcSetMode(ADC_ADCB, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);

    AdcaRegs.ADCCTL1.bit.INTPULSEPOS = 1;
    AdcaRegs.ADCCTL1.bit.ADCPWDNZ = 1;
    DELAY_US(1000);

    /* SOC0 -> ADCIN14 */
    AdcaRegs.ADCSOC0CTL.bit.CHSEL = ADC_CHANNEL;
    AdcaRegs.ADCSOC0CTL.bit.ACQPS = 25U;

    /* TRIGSEL irrelevant for software force (we'll use ADCSOCFRC1) but set to a safe value */
#ifdef ADCTRIG_SW_FORCE
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = ADCTRIG_SW_FORCE;
#else
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = 0U; /* 0 is often CPU1_SOCA or SW; not used when forcing ADCSOCFRC1 */
#endif

    /* Make ADCINT1 correspond to EOC0 */
    AdcaRegs.ADCINTSEL1N2.bit.INT1SEL = 0;  /* EOC0 */
    AdcaRegs.ADCINTSEL1N2.bit.INT1E = 1;
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;
    EDIS;
}

/* ---------- MAIN: software-triggered capture ---------- */
int main(void)
{
#ifdef _FLASH
    memcpy(&RamfuncsRunStart, &RamfuncsLoadStart, (size_t)&RamfuncsLoadSize);
#endif

    InitSysCtrl();
    DINT;
    InitPieCtrl();
    InitPieVectTable();

    /* Init ADC for software triggering and SCIA */
    initADC_for_SOC0_for_software_trigger();
    initSCIA_and_pins(DUMP_BAUDRATE);

    /* announce start */
    {
        const char *ms = "CAPTURE_STARTED\n";
        const char *q = ms;
        while (*q) scia_send_byte_blocking((unsigned char)*q++);
    }

    /* do software-triggered captures in a loop (polling ADCINT1) */
    sampleIndex = 0;
    for (uint32_t i = 0; i < CAPTURE_SAMPLES; ++i) {
        /* Force SOC0 */
        AdcaRegs.ADCSOCFRC1.all = 0x1;

        /* Wait for end of conversion (ADCINT1 will be set because INT1SEL = EOC0) */
        while (AdcaRegs.ADCINTFLG.bit.ADCINT1 == 0) { }  /* busy wait */

        /* Read result and clear flag */
        uint16_t s = (uint16_t)AdcaResultRegs.ADCRESULT0;
        adcBuffer[i] = s;
        sampleIndex++;

        AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

        /* short gap to avoid hammering ADC too fast while debugging */
        DELAY_US(50); /* 50 us between forced conversions; adjust or remove later */
    }

    /* done capturing */
    dump_buffer_over_uart_with_header();

    /* Halt */
    for (;;) { __asm(" NOP"); }
    return 0;
}
