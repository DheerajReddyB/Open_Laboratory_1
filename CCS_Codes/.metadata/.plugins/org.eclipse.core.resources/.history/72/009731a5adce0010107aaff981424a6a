// epwm1_adca_capture_clean.c
// ePWM1 SOCA -> ADCA SOC0 -> RAM -> SCIA binary dump
// Drop-in file for TI C2000 F28379D (CCS). Designed for C89 compatibility.
// Author: ChatGPT (adapted for F28379D)

#include <stdint.h>
#include <stdbool.h>
#include <string.h>

/* TI framework headers - F28x_Project.h should bring device headers */
#include "F28x_Project.h"

/* Fallback definitions if some older headers don't define these macros */
#ifndef ADCTRIG_EPWM1_SOCA
  /* value mapping is platform dependent; 5 is commonly EPWM1_SOCA for F28x7xD */
  #define ADCTRIG_EPWM1_SOCA 5U
#endif

/* ---------------- CONFIG ---------------- */
#define CAPTURE_SAMPLES   (1024U)          /* number of samples to capture */
#define ADC_CHANNEL       0x0EU            /* ADCIN14 */
#define DUMP_BAUDRATE     115200U

/* CPU and sampling settings */
#define SYSCLK_HZ         200000000UL      /* set to your SYSCLK (Hz) */
#define SAMPLE_RATE       500000UL         /* desired sample rate (Hz): 500kS/s default */
/* compute TBPRD (TBCLK assumed = SYSCLK with no TBCLK divider). Keep integer math safe */
#define EPWM_TBPRD        ((uint16_t)((SYSCLK_HZ / SAMPLE_RATE) - 1U))
/* ACQPS: sample window (ACQPS + 1 ADC clock cycles). Increase if source is high impedance */
#define ADC_SOC_ACQPS     14U
/* ---------------------------------------- */

/* Capture buffer in RAM */
static volatile uint16_t adcBuffer[CAPTURE_SAMPLES];
static volatile uint32_t sampleIndex = 0U;
static volatile bool capture_done = false;

/* Forward declarations */
void initSCIA_blocking(uint32_t baud);
void scia_send_byte_blocking(unsigned char b);
void initSCIA_and_pins(uint32_t baud);
void initEPWM1_for_sampling(uint16_t tbprd);
void initADC_for_epwm_soc0(void);
__interrupt void adca_isr(void);
void dump_buffer_over_uart_with_header(void);

/* ---------------- SCIA helpers ---------------- */
void initSCIA_blocking(uint32_t baud)
{
    EALLOW;
    /* 8-bit, 1 stop, no parity */
    SciaRegs.SCICCR.all = 0x0007;
    /* SCICTL1: SW reset (will release later) */
    SciaRegs.SCICTL1.all = 0x0003;
    SciaRegs.SCICTL2.bit.TXINTENA = 1;
    SciaRegs.SCICTL2.bit.RXBKINTENA = 1;

    /* Simple baud divisor approximate for LSPCLK ~50 MHz (typical when SYSCLK=200MHz) */
    if (baud == 115200U) {
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = 53U;
    } else if (baud == 921600U) {
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = 6U;
    } else {
        uint32_t scil = (50000000UL / (16UL * baud));
        if (scil) scil -= 1U;
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = (uint16_t)scil;
    }

    /* Release SCI from reset */
    SciaRegs.SCICTL1.all = 0x0023;
    EDIS;
}

void scia_send_byte_blocking(unsigned char b)
{
    SciaRegs.SCITXBUF.all = b;
    /* Tiny delay to avoid first-byte-loss on some hosts */
    DELAY_US(200);
}

void initSCIA_and_pins(uint32_t baud)
{
    EALLOW;
    /* Route SCIA to GPIO42/43 (TX=GPIO42, RX=GPIO43) - common for F2837xD examples.
       If your board uses different pins, change accordingly. */
    GpioCtrlRegs.GPBMUX1.bit.GPIO42  = 3;
    GpioCtrlRegs.GPBMUX1.bit.GPIO43  = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO42 = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO43 = 3;

    /* LED pin (GPIO31) as plain GPIO output: GPADIR only (no mux change needed) */
    GpioCtrlRegs.GPADIR.bit.GPIO31 = 1;
    GpioDataRegs.GPASET.bit.GPIO31 = 1;  /* LED off/high (board dependent) */
    EDIS;

    initSCIA_blocking(baud);

    /* Triple HELLO to terminal - C89 style loop */
    {
        const char *hello = "HELLO\n";
        int rep;
        for (rep = 0; rep < 3; ++rep) {
            const char *p = hello;
            while (*p) scia_send_byte_blocking((unsigned char)*p++);
            DELAY_US(20000);
        }
    }
}

/* ---------------- ePWM1 setup ----------------
   TBCLK = SYSCLK (we set TBCTL dividers to 1). EPWM1 SOCA triggers on CTR = ZERO.
*/
void initEPWM1_for_sampling(uint16_t tbprd)
{
    EALLOW;
    /* Ensure ePWM clocks are enabled by InitSysCtrl earlier */
    EPwm1Regs.TBCTL.bit.PHSEN = TB_DISABLE;     /* disable phase load */
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_COUNT_UP;  /* up count */
    EPwm1Regs.TBPRD = tbprd;
    EPwm1Regs.TBCTL.bit.HSPCLKDIV = TB_DIV1;    /* high speed prescaler = 1 */
    EPwm1Regs.TBCTL.bit.CLKDIV = TB_DIV1;       /* clock divider = 1 */
    EPwm1Regs.TBCTL.bit.SYNCOSEL = TB_CTR_ZERO; /* sync out on zero */

    /* Configure SOCA: generate when TBCTR == 0 */
    EPwm1Regs.ETSEL.bit.SOCAEN = 1;
    EPwm1Regs.ETSEL.bit.SOCASEL = ET_CTR_ZERO;  /* SOCA on CTR = ZERO */
    EPwm1Regs.ETPS.bit.SOCAPRD = ET_1ST;        /* generate on first event */

    /* No PWM outputs needed for this test; leave CMP/DB config default */

    EDIS;
}

/* ---------------- ADC init for SOC0 triggered by EPWM1 SOCA ---------------- */
void initADC_for_epwm_soc0(void)
{
    EALLOW;
    /* ADC prescale: ADCCLK = SYSCLK/4 when PRESCALE=6 (example); adjust if needed */
    AdcaRegs.ADCCTL2.bit.PRESCALE = 6;
    AdcbRegs.ADCCTL2.bit.PRESCALE = 6;

    /* 12-bit single-ended mode */
    AdcSetMode(ADC_ADCA, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);
    AdcSetMode(ADC_ADCB, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);

    /* result latched at end of conversion & power up ADC */
    AdcaRegs.ADCCTL1.bit.INTPULSEPOS = 1;
    AdcaRegs.ADCCTL1.bit.ADCPWDNZ = 1;
    DELAY_US(1000);

    /* Configure SOC0 */
    AdcaRegs.ADCSOC0CTL.bit.CHSEL = ADC_CHANNEL;
    AdcaRegs.ADCSOC0CTL.bit.ACQPS = ADC_SOC_ACQPS;        /* ACQPS cycles */
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = ADCTRIG_EPWM1_SOCA;/* tie SOC0 to EPWM1 SOCA */

    /* Map ADCINT1 to EOC0 */
    AdcaRegs.ADCINTSEL1N2.bit.INT1SEL = 0;  /* EOC0 */
    AdcaRegs.ADCINTSEL1N2.bit.INT1E = 1;
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;
    EDIS;

    /* Hook ISR */
    EALLOW;
    PieVectTable.ADCA1_INT = &adca_isr; /* ADCA INT1 ISR vector */
    EDIS;

    /* Enable PIE and CPU ints for ADCA INT1 (PIE group1, PIE1.INT1) */
    IER |= M_INT1;                      /* CPU INT1 enable */
    PieCtrlRegs.PIEIER1.bit.INTx1 = 1;  /* PIE1.1 enable */

    /* Note: ISR will clear ADCINT1. */
}

/* ---------------- ADCA ISR ----------------
   Stores ADCRESULT0 into buffer. Stops when buffer full.
*/
__interrupt void adca_isr(void)
{
    uint16_t v = (uint16_t)AdcaResultRegs.ADCRESULT0;

    if (sampleIndex < CAPTURE_SAMPLES) {
        adcBuffer[sampleIndex] = v;
        sampleIndex++;
    }

    /* clear ADCINT1 flag */
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

    if (sampleIndex >= CAPTURE_SAMPLES) {
        /* Stop further SOCA triggers */
        EALLOW;
        EPwm1Regs.ETSEL.bit.SOCAEN = 0;
        /* disable INT1 to avoid further ISRs */
        AdcaRegs.ADCINTSEL1N2.bit.INT1E = 0;
        PieCtrlRegs.PIEIER1.bit.INTx1 = 0;
        EDIS;

        capture_done = true;
    }

    /* Acknowledge PIE group 1 */
    PieCtrlRegs.PIEACK.all = PIEACK_GROUP1;
}

/* ---------------- UART dump ---------------- */
void dump_buffer_over_uart_with_header(void)
{
    const char *hdr = "CAPTURE_DONE\n";
    const char *p = hdr;
    while (*p) scia_send_byte_blocking((unsigned char)*p++);

    /* brief LED blink */
    GpioDataRegs.GPACLEAR.bit.GPIO31 = 1;
    DELAY_US(1000);
    GpioDataRegs.GPASET.bit.GPIO31 = 1;

    /* send binary LSB then MSB */
    {
        uint32_t i;
        for (i = 0U; i < sampleIndex; ++i) {
            uint16_t val = adcBuffer[i];
            scia_send_byte_blocking((unsigned char)(val & 0xFF));
            scia_send_byte_blocking((unsigned char)(val >> 8));
        }
    }

    const char *endm = "\nCAPTURE_END\n";
    p = endm;
    while (*p) scia_send_byte_blocking((unsigned char)*p++);
}

/* ----------------- main ----------------- */
int main(void)
{
#ifdef _FLASH
    /* If running from flash, copy critical functions to RAM (TI examples do this) */
    memcpy(&RamfuncsRunStart, &RamfuncsLoadStart, (size_t)&RamfuncsLoadSize);
#endif

    /* Basic init */
    InitSysCtrl();        /* sets up PLL, peripherals clocking (assumes project configured to 200MHz) */
    DINT;                 /* disable CPU interrupts */
    InitPieCtrl();        /* clear PIE and disable */
    InitPieVectTable();   /* populate PIE vector table with defaults */

    /* Setup SCIA and LED pin */
    initSCIA_and_pins(DUMP_BAUDRATE);

    /* Announce start */
    {
        const char *msg = "CAPTURE_STARTED\n";
        const char *q = msg;
        while (*q) scia_send_byte_blocking((unsigned char)*q++);
    }

    /* Ensure GPIO31 is output (LED) */
    EALLOW;
    GpioCtrlRegs.GPAMUX1.all &= ~(1U << 31); /* try clear mux bit if present (safe) */
    GpioCtrlRegs.GPADIR.bit.GPIO31 = 1;
    GpioDataRegs.GPASET.bit.GPIO31 = 1;
    EDIS;

    /* Initialize EPWM1 and ADCA */
    initEPWM1_for_sampling((uint16_t)EPWM_TBPRD);
    initADC_for_epwm_soc0();

    /* Clear counters */
    sampleIndex = 0U;
    capture_done = false;

    /* Enable global interrupts */
    EINT;
    ERTM;

    /* Wait until capture done (ISR will stop EPWM triggers and set capture_done) */
    while (!capture_done) {
        /* idle */
    }

    /* Dump buffer to UART */
    dump_buffer_over_uart_with_header();

    /* Halt here for debugging */
    for (;;) {
        NOP;
    }

    /* never reached */
    return 0;
}
