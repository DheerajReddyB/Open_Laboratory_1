// f28379d_epwm_1MSPS_capture_debug_fixed.c
// 1 MSPS ADC capture using ePWM1 SOCA trigger -> RAM -> UART dump (binary)
// Fixed: reduced ACQPS for 1MHz trigger, computed UART byte delay, cleared ADCINT before start.

#include <stdio.h>
#include <string.h>
#include <stdbool.h>

#include "F28x_Project.h"    // device headers (contains Uint16/Uint32 definitions)

/* ---------- USER CONFIG (tweak as needed) ---------- */
#define CAPTURE_SAMPLES    1024U    /* number of samples to capture */
#define ADC_CHANNEL        0x0EU    /* ADCIN14 */
#define BAUDRATE           921600U  /* UART baud for dump (set to 115200 or 921600) */
#define TBPRD_1MHZ         99U      /* TBPRD for 1 MHz when TBCLK = 100MHz */

#define ACQPS_VAL          6U       /* ACQPS -> acquisition window = ACQPS+1 cycles (reduced for 1MHz) */
#define PREVIEW_COUNT      32U      /* how many samples to print as ASCII before binary dump */
/* -------------------------------------------------- */

static volatile Uint16 adcBuffer[CAPTURE_SAMPLES];
static volatile Uint32 sampleIndex = 0U;

/* computed per-byte delay for UART (microseconds), set in init_scia */
static Uint32 scia_tx_delay_us = 100U;

/* prototypes */
void init_scia(Uint32 baud);
void scia_send(Uint16 c);
void uart_print(const char *msg);

void init_epwm_1mhz_trigger(void);
void init_adc_epwm_triggered(void);

void dump_buffer_uart(void);
void preview_first_samples(void);

void configure_debug_gpio(void);

/* ---------------- UART helpers ---------------- */
void init_scia(Uint32 baud)
{
    EALLOW;
    /* route SCIA to GPIO42/43 */
    GpioCtrlRegs.GPBMUX1.bit.GPIO42 = 3;
    GpioCtrlRegs.GPBMUX1.bit.GPIO43 = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO42 = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO43 = 3;
    EDIS;

    EALLOW;
    SciaRegs.SCICCR.all = 0x0007;  /* 8-bit, 1 stop, no parity */
    SciaRegs.SCICTL1.all = 0x0003; /* enable TX/RX in reset */
    SciaRegs.SCICTL2.bit.TXINTENA = 1;
    SciaRegs.SCICTL2.bit.RXBKINTENA = 1;

    /* Baud settings for LSPCLK = 50 MHz (typical) */
    if (baud == 115200U)
    {
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = 53U;
    }
    else if (baud == 921600U)
    {
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = 6U;
    }
    else
    {
        /* generic integer divider calculation (approx). LSPCLK/16/(SCILBAUD+1) = baud */
        /* LSPCLK assumed 50 MHz here; change if your LSPCLK differs. */
        Uint32 scil = (50000000UL / (16UL * (Uint32)baud));
        if (scil) scil -= 1U;
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = (Uint16)scil;
    }

    /* Release SCI from reset */
    SciaRegs.SCICTL1.all = 0x0023;
    EDIS;

    /* compute per-byte delay in microseconds assuming ~10 bits per byte (start+8+stop) */
    scia_tx_delay_us = (Uint32)((1000000ULL * 10ULL + (baud/2)) / baud);
    if (scia_tx_delay_us < 10U) scia_tx_delay_us = 10U; /* a safe floor */
}

/* blocking send: SCITXBUF.all is Uint16 in TI headers
   We use a computed delay to avoid hardcoding for a given baudrate. */
void scia_send(Uint16 c)
{
    SciaRegs.SCITXBUF.all = c;
    DELAY_US(scia_tx_delay_us);
}

void uart_print(const char *msg)
{
    const char *p = msg;
    while (*p) { scia_send((Uint16)*p++); }
}

/* ---------------- EPWM: 1 MHz trigger ---------------- */
void init_epwm_1mhz_trigger(void)
{
    EALLOW;

    /* Freeze time-base while configuring */
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_FREEZE;

    /* TBCLK = SYSCLK / 2 = 200MHz/2 = 100MHz (typical) */
    EPwm1Regs.TBCTL.bit.CLKDIV = TB_DIV1;      /* /1 */
    EPwm1Regs.TBCTL.bit.HSPCLKDIV = TB_DIV1;   /* /1 */

    EPwm1Regs.TBPRD = TBPRD_1MHZ;              /* 99 -> 1 MHz when TBCLK=100MHz */

    EPwm1Regs.TBCTL.bit.PHSEN = TB_DISABLE;
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_COUNT_UP;

    /* Configure SOCA on CTR=0 */
    EPwm1Regs.ETSEL.bit.SOCAEN = 1;
    EPwm1Regs.ETSEL.bit.SOCASEL = ET_CTR_ZERO;
    EPwm1Regs.ETPS.bit.SOCAPRD = ET_1ST;

    /* Start time-base counter (stay in count mode, will be enabled via TBCLKSYNC) */
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_COUNT_UP;

    EDIS;
}

/* ---------------- ADC: ePWM triggered, ACQPS increased ---------------- */
void init_adc_epwm_triggered(void)
{
    EALLOW;

    /* ADCCLK prescale => ADCCLK = SYSCLK/4 -> 50MHz for SYSCLK=200MHz (typical) */
    /* PRESCALE value '6' chosen in original code; leave as-is but verify with your system clocks. */
    AdcaRegs.ADCCTL2.bit.PRESCALE = 6;
    AdcbRegs.ADCCTL2.bit.PRESCALE = 6;

    AdcSetMode(ADC_ADCA, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);
    AdcSetMode(ADC_ADCB, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);

    AdcaRegs.ADCCTL1.bit.ADCPWDNZ = 1;  /* power up */
    DELAY_US(1000);

    /* SOC0 configuration: ADCIN14 */
    AdcaRegs.ADCSOC0CTL.bit.CHSEL = ADC_CHANNEL;
    AdcaRegs.ADCSOC0CTL.bit.ACQPS = ACQPS_VAL;   /* acquisition window = ACQPS+1 ADCCLK cycles */

    /* TRIGSEL: ePWM1 SOCA - use macro if available else fallback */
#ifdef ADCTRIG_EPWM1_SOCA
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = ADCTRIG_EPWM1_SOCA;
#else
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = 5U;
#endif

    /* Map ADCINT1 to EOC0 */
    AdcaRegs.ADCINTSEL1N2.bit.INT1SEL = 0; /* EOC0 */
    AdcaRegs.ADCINTSEL1N2.bit.INT1E = 1;
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

    EDIS;
}

/* configure a GPIO for debug toggling (GPIO31) */
void configure_debug_gpio(void)
{
    EALLOW;
    GpioCtrlRegs.GPADIR.bit.GPIO31 = 1;   /* output */
    GpioDataRegs.GPADAT.bit.GPIO31 = 1;   /* default high (LED off on some boards) */
    EDIS;
}

/* Preview ASCII of first PREVIEW_COUNT samples (human readable) */
void preview_first_samples(void)
{
    Uint32 j;
    char tmp[48];

    uart_print("SAMPLES_PREVIEW\n");
    for (j = 0U; j < PREVIEW_COUNT && j < CAPTURE_SAMPLES; ++j)
    {
        /* Format into tmp and print */
        sprintf(tmp, "%u\n", (unsigned)adcBuffer[j]);
        uart_print(tmp);
    }
    uart_print("SAMPLES_PREVIEW_END\n");
}

/* Binary dump (LSB then MSB), with ASCII markers */
void dump_buffer_uart(void)
{
    uart_print("CAPTURE_DONE\n");

    {
        Uint32 idx;
        for (idx = 0U; idx < CAPTURE_SAMPLES; ++idx)
        {
            Uint16 v = adcBuffer[idx];
            /* send LSB then MSB */
            scia_send((Uint16)(v & 0xFFU));
            scia_send((Uint16)((v >> 8) & 0xFFU));
        }
    }

    uart_print("\nCAPTURE_END\n");
}

/* ---------------- MAIN ---------------- */
int main(void)
{
#ifdef _FLASH
    /* copy RAM functions if running from flash */
    memcpy(&RamfuncsRunStart, &RamfuncsLoadStart, (size_t)&RamfuncsLoadSize);
#endif

    /* System init */
    InitSysCtrl();
    DINT;
    InitPieCtrl();
    InitPieVectTable();

    /* Init UART */
    init_scia(BAUDRATE);

    /* Configure debug GPIO */
    configure_debug_gpio();

    /* Greetings & start marker */
    uart_print("HELLO\nHELLO\nHELLO\n");
    uart_print("CAPTURE_STARTED\n");

    /* Configure EPWM and ADC */
    init_epwm_1mhz_trigger();
    init_adc_epwm_triggered();

    /* Clear ADCINT in case it's set, before enabling TBCLKSYNC */
    EALLOW;
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;
    EDIS;

    /* Start ePWM timebase (start generates SOCA at TBPRD->CTR=0 at configured rate) */
    EALLOW;
    CpuSysRegs.PCLKCR0.bit.TBCLKSYNC = 1;
    EDIS;

    /* Capture loop: poll ADCINT1 and store samples.
       Toggle GPIO31 on every sample for scope measurement. */
    sampleIndex = 0U;
    while (sampleIndex < CAPTURE_SAMPLES)
    {
        if (AdcaRegs.ADCINTFLG.bit.ADCINT1)
        {
            /* Clear flag */
            AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

            /* Read result */
            adcBuffer[sampleIndex] = (Uint16)AdcaResultRegs.ADCRESULT0;

            /* Toggle debug GPIO (fast) */
            GpioDataRegs.GPATOGGLE.bit.GPIO31 = 1;

            sampleIndex++;
        }
    }

    /* Freeze EPWM to stop triggers (safe) */
    EALLOW;
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_FREEZE;
    EDIS;

    /* Preview first samples as ASCII so you can inspect numeric values quickly */
    preview_first_samples();

    /* Dump binary block (LSB/MSB) */
    dump_buffer_uart();

    /* Halt */
    for (;;)
    {
        __asm(" NOP");
    }

    return 0;
}
