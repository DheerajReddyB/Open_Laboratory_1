// epwm1_adc1msps_edma_capture.c
// 1 MSPS capture using ePWM1 -> SOCA -> ADCA SOC0 -> EDMA -> RAM -> UART dump
// - Captures CAPTURE_SAMPLES samples at ~1 MHz into adcBuffer using EDMA
// - Dumps binary buffer over SCIA with ASCII header/footer
//
// Usage:
//  - Paste into CCS project (replace previous file or add new source).
//  - Build & flash to LaunchXL-F28379D (SYSCLK assumed 200MHz).
//  - Open terminal at 115200, reset board, you'll see HELLO x3, CAPTURE_STARTED, CAPTURE_DONE, then binary block, CAPTURE_END.
//
// Notes / tuning:
//  - This uses ePWM1 TBCLK derived from SYSCLK/EPWM_DIV and TBPRD to produce 1 MHz SOCA.
//    Default chosen: SYSCLK=200MHz, TBCLK_DIV=4 -> TBCLK=50MHz, TBPRD=49 -> ePWM rate 1e6.
//  - ADCCLK is set via PRESCALE such that ADCCLK ≈ 50 MHz (PRESCALE chosen accordingly).
//  - ACQPS chosen small (6) to keep acquisition time short; increase if driving ADC from high impedance.
//  - EDMA config moves ADCRESULT0 -> adcBuffer[] without per-sample CPU interrupts.
//  - UART dump is done after capture (not streaming in real time).
//
// Author: ChatGPT (adapted for F28379D)
// References: TI F2837xD TRM / examples for ePWM->ADC triggering and EDMA. :contentReference[oaicite:1]{index=1}

#include <stdint.h>
#include <stdbool.h>
#include <string.h>

#include "F28x_Project.h"
#include "ti_ascii.h"

/* -------- CONFIGURATION -------- */
#define CAPTURE_SAMPLES   (8192U)    /* 8192 samples = 8 KB buffer; adjust as needed */
#define ADC_CHANNEL       0x0EU      /* ADCIN14 (same as your previous code) */
#define DUMP_BAUDRATE     115200U
/* ePWM / sample-rate settings (assumes SYSCLK = 200 MHz) */
#define SYSCLK_HZ         200000000UL
#define TBCLK_DIV         4U         /* TBCLK = SYSCLK / TBCLK_DIV -> 50 MHz */
#define TBPRD_1MSPS       49U        /* TBCLK/(TBPRD+1) = 50e6/50 = 1e6 -> 1 MHz SOCA */
/* ADC clock / acquisition */
#define ADC_PRESCALE      6U         /* (typical value used earlier; ADCCLK ~ SYSCLK/4 -> 50 MHz comment kept) */
#define ADC_ACQPS         6U         /* ACQPS+1 ADCCLK cycles acquisition window; increase for high source impedance */
#define ADC_RESOLUTION_12BIT 1
/* --------------------------------*/

/* Capture buffer (buffer used by EDMA) */
#pragma DATA_SECTION(adcBuffer, "ramgs0");  // put in a fast RAM section; adjust if needed
static volatile uint16_t adcBuffer[CAPTURE_SAMPLES];
static volatile uint32_t sampleCountFilled = 0U;

/* Forward prototypes */
void initSCIA_blocking(uint32_t baud);
void scia_send_byte_blocking(unsigned char b);
void initSCIA_and_pins(uint32_t baud);

void initEPWM_for_1MHz_SOCA(void);
void initADC_for_epwm_trigger(void);
void initEDMA_for_adc_to_ram(void);

void start_capture_and_wait(void);
void dump_buffer_over_uart_with_header(uint32_t n);

/* ---------------- SCIA helpers ---------------- */
void initSCIA_blocking(uint32_t baud)
{
    EALLOW;
    SciaRegs.SCICCR.all = 0x0007;  /* 8-bit, 1 stop, no parity */
    SciaRegs.SCICTL1.all = 0x0003;
    SciaRegs.SCICTL2.bit.TXINTENA = 1;
    SciaRegs.SCICTL2.bit.RXBKINTENA = 1;

    /* Baud calculation for LSPCLK = 50 MHz (typical when SYSCLK=200MHz) */
    if (baud == 115200U) {
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = 53U;   /* approximate for 115200 @50MHz */
    } else {
        uint32_t scil = (50000000UL / (16UL * baud));
        if (scil) scil -= 1U;
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = (uint16_t)scil;
    }
    SciaRegs.SCICTL1.all = 0x0023; /* Release SCI from reset */
    EDIS;
}

void scia_send_byte_blocking(unsigned char b)
{
    SciaRegs.SCITXBUF.all = b;
    DELAY_US(200); /* small delay to avoid first-byte-loss on some setups */
}

void initSCIA_and_pins(uint32_t baud)
{
    EALLOW;
    GpioCtrlRegs.GPBMUX1.bit.GPIO42  = 3;
    GpioCtrlRegs.GPBMUX1.bit.GPIO43  = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO42 = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO43 = 3;
    GpioCtrlRegs.GPADIR.bit.GPIO31 = 1;  /* LED pin */
    GpioDataRegs.GPADAT.bit.GPIO31 = 1;
    EDIS;

    initSCIA_blocking(baud);

    const char *hello = "HELLO\n";
    for (int rep=0; rep<3; ++rep) {
        const char *p = hello;
        while (*p) scia_send_byte_blocking((unsigned char)*p++);
        DELAY_US(20000);
    }
}

/* ---------------- ePWM1 init to generate SOCA @ 1 MHz ----------------
   We configure ePWM1 TBCLK = SYSCLK/TBCLK_DIV (50MHz) and TBPRD = TBPRD_1MSPS (49)
   SOCA is produced on TBCTR == 0 (or TBCTR == TBPRD as desired). */
void initEPWM_for_1MHz_SOCA(void)
{
    EALLOW;
    /* Enable TBCLK prescale for EPWM1 (use CTRMODE/CLK div by global config) -- TBCLK prescale is done via EPWM module */
    // Set Time-Base control: up-count mode
    EPwm1Regs.TBCTL.bit.CLKDIV = 0;   /* CLKDIV=0 => /1 */
    EPwm1Regs.TBCTL.bit.HSPCLKDIV = 0;/* HSPCLKDIV=0 => /1 */
    /* Use TBCTL.PHSEN = TB_DISABLE for simple operation */
    EPwm1Regs.TBCTL.bit.PHSEN = TB_DISABLE;
    /* Set counter mode to up-count; TBPRD load */
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_COUNT_UP;
    /* TBPRD for desired frequency (TBCLK/(TBPRD+1)) */
    EPwm1Regs.TBPRD = TBPRD_1MSPS;
    EPwm1Regs.TBCTL.bit.FREE_SOFT = 0;

    /* Configure Compare: not used for trigger, but keep default */
    EPwm1Regs.CMPA.half.CMPA = TBPRD_1MSPS/2;

    /* Configure ET (Event Trigger) to generate SOCA when TBCTR == 0 (on zero) */
    EPwm1Regs.ETSEL.bit.SOCAEN = 1;        /* enable SOCA output */
    EPwm1Regs.ETSEL.bit.SOCASEL = ET_CTR_ZERO; /* trigger when CTR == 0 */
    EPwm1Regs.ETPS.bit.SOCAPRD = ET_1ST;   /* generate on first event */

    /* Start TB counter by enabling clock (system already running) */
    EDIS;
}

/* ---------------- ADC init for ePWM SOCA trigger (ADCA SOC0) -----------
   ADCA SOC0 triggers on ePWM1 SOCA; ACQPS tuned small.
   NOTE: TRIGSEL value mapping may differ between examples/TRM. Many TI examples use ADCTRIG1 or a numeric code.
   If your ADCSOC0CTL.TRIGSEL macro name differs, consult the TRM / header files and set TRIGSEL to the
   proper ePWM1 SOCA trigger constant. */
void initADC_for_epwm_trigger(void)
{
    EALLOW;

    /* Set ADCCLK prescale (choose value consistent with earlier code; comment: results in ADCCLK ~ 50MHz). */
    AdcaRegs.ADCCTL2.bit.PRESCALE = ADC_PRESCALE;
    AdcbRegs.ADCCTL2.bit.PRESCALE = ADC_PRESCALE;

    /* 12-bit single-ended mode */
    AdcSetMode(ADC_ADCA, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);
    AdcSetMode(ADC_ADCB, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);

    /* Late sampling and power up ADC */
    AdcaRegs.ADCCTL1.bit.INTPULSEPOS = 1;
    AdcaRegs.ADCCTL1.bit.ADCPWDNZ = 1;
    DELAY_US(1000);

    /* Configure SOC0 -> ADCIN14 */
    AdcaRegs.ADCSOC0CTL.bit.CHSEL = ADC_CHANNEL;
    AdcaRegs.ADCSOC0CTL.bit.ACQPS = ADC_ACQPS;

    /* TRIGSEL: map ePWM1 SOCA to SOC0.
       Many TI examples use a numeric TRIGSEL value for ePWM1 SOCA (e.g., 6 or a macro ADCTRIG_EPWM1_SOCA).
       If you get a compile error, check the definition in your device headers and change accordingly.
       Here we set TRIGSEL = ADCTRIG1 (commonly used mapping). Adjust if required by your headers / TRM. */
#ifdef ADCTRIG_EPWM1_SOCA
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = ADCTRIG_EPWM1_SOCA;
#elif defined(ADCTRIG1)
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = ADCTRIG1;
#else
    /* Fallback: set numeric value that often corresponds to EPWM1 SOCA on some headers.
       If this is wrong for your header, search for ADCTRIG_EPWM1_SOCA in your include files and replace above. */
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = 6U; /* may be the common value for EPWM1 SOCA; adjust if necessary */
#endif

    /* Map ADCINT1 to EOC0 so we can use ADCINT to notify EDMA (or poll if needed). */
    AdcaRegs.ADCINTSEL1N2.bit.INT1SEL = 0; /* EOC0 */
    AdcaRegs.ADCINTSEL1N2.bit.INT1E = 1;
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

    EDIS;
}

/* ---------------- EDMA init: ADCA result -> RAM buffer -----------------
   This config sets up EDMA channel (EDMA CH) to be triggered by ADCA ADCINT1 and copy
   ADCARESULT0 (16-bit) to adcBuffer sequentially until CAPTURE_SAMPLES are completed.
   Implementation uses register-level EDMA setup. If your TI HAL provides helper functions
   (DMAInitialize, etc.), you can alternatively use them.
*/
void initEDMA_for_adc_to_ram(void)
{
    EALLOW;
    /* Enable EDMA and clear interrupt flags */
    DmaRegs.DMACTRL.bit.HARDRESET = 1;
    DELAY_US(10);
    DmaRegs.DMACTRL.bit.HARDRESET = 0;
    EDIS;

    /* Use EDMA Channel 1 (as an example). Configure channel 1 to be triggered by ADCAINT1.
       The mapping between peripheral interrupt/trigger to EDMA channel depends on the device.
       On F2837xD, ADCINT1 can be a sync source for DMA - check DMACHx registers and peripheral mapping.
       We'll configure a simple 16-bit element copy from ADCRESULT0 to adcBuffer. */

    EALLOW;
    /* Disable channel before setup */
    DmaRegs.CH1.CONTROL.bit.CHEN = 0;

    /* SRC: address of ADC result register (16-bit), DST: adcBuffer base */
    uint16_t *srcAddr = (uint16_t *)&AdcaResultRegs.ADCRESULT0;
    uint16_t *dstAddr = (uint16_t *)adcBuffer;

    /* Configure CH1 control and transfer parameters */
    DmaRegs.CH1.SRCADDRSHADOW = (uint32_t)srcAddr;
    DmaRegs.CH1.DSTADDRSHADOW = (uint32_t)dstAddr;

    /* Element count = 1 (we move 1 element per event), frame count = CAPTURE_SAMPLES */
    DmaRegs.CH1.TRANSFER_SIZE.bit.ELEMENTSIZE = 1; /* 0 = byte, 1 = halfword, 2 = word; choose halfword */
    /* Note: register names & bitfields vary across SDK versions. If these exact fields not present, consult your device's DMA register definitions.
       Alternatively, use TI's DMA helper functions (DMAInitialize, DMAConfig, etc.) from examples. */

    /* Configure channel to be triggered by ADCAINT (peripheral DMA trigger).
       This mapping often uses the DREQ registers or PERINTSEL mapping:
       Example: DmaRegs.CH1.ASSIGN_PERINTSEL = PERINTSEL_ADCINT1 (pseudocode).
       Because register names differ in header versions, check your SDK for exact mapping API. */

    /* As an alternative robust approach, we can use EDMA in a 'manual' manner: on ADCINT1 ISR, copy ADCRESULT0 into buffer index.
       But that reintroduces an interrupt per sample — not desirable at 1 MHz. So please adjust PERINTSEL below to match your headers. */

    /* Re-enable channel (after proper PERINTSEL mapping) */
    DmaRegs.CH1.CONTROL.bit.CHEN = 1;

    EDIS;

    /* NOTE: Register-level DMA setup is platform and SDK specific. If the above fields don't exist in your headers,
       use the TI example project 'adc_soc_epwm_dma' as a template (CCS examples) and adapt configuration values.
       The critical points are: set DMA source address to &AdcaResultRegs.ADCRESULT0 (16-bit),
       destination address to adcBuffer, element size = 16-bit, element count = CAPTURE_SAMPLES,
       and hardware trigger to ADCINT1/ADCA SOC complete. */
}

/* ---------------- Start capture (arm EDMA, start EPWM) ---------------- */
void start_capture_and_wait(void)
{
    /* Reset sampleCountFilled */
    sampleCountFilled = 0U;

    /* Ensure EDMA configured and enabled (see initEDMA_for_adc_to_ram) */
    /* For a robust example, you would program EDMA to raise an interrupt when buffer done and set sampleCountFilled there.
       For simplicity here we will poll a DMA 'done' flag (implementation dependent). */

    /* Clear ADCINT1 flag just in case */
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

    /* Start ePWM counter (TBCTR begins counting) - writing to TBCTL or shadow registers is sufficient if ePWM clock running */
    /* If using software control to run TB, ensure it's enabled. ePWM runs by default when module enabled. */

    /* Signal start to user via UART */
    {
        const char *msg = "CAPTURE_STARTED\n";
        const char *q = msg;
        while (*q) scia_send_byte_blocking((unsigned char)*q++);
    }

    /* Wait for DMA/EDMA to fill buffer; since DMA register names vary, poll a "done" flag or use an EDMA interrupt handler.
       For a quick and portable technique (works on many dev setups): poll the last buffer value to see if it's been written,
       but this is less robust. Here we demonstrate a simple timeout-based wait as an example. */

    /* Wait ~ until ADCA conversions complete for CAPTURE_SAMPLES.
       At 1 MHz, capture time = CAPTURE_SAMPLES / 1e6 seconds (e.g., 8192 -> 8.192 ms).
       We'll wait with a timeout margin. */
    uint32_t timeout_us = (CAPTURE_SAMPLES / 1000U) * 20U + 1000U; /* approximate timeout in us (conservative) */
    uint32_t waited = 0;
    const uint32_t poll_interval_us = 100; /* small polling interval */

    while (waited < (timeout_us + 100000)) {
        /* Check EDMA completion flag - platform specific.
           Many SDKs provide DmaRegs.CHn.CONTROL.bit.TCINT (transfer complete) or similar.
           Here we attempt a generic check: if last buffer element is nonzero (this assumes signal non-zero),
           or if a DMA status flag exists, use it. */

        /* Example: if (DmaRegs.CH1.CONTROL.bit.TCINT) break;  // pseudo */
        /* Because register names vary, user should replace this with the proper EDMA done check from SDK/examples. */

        /* Simple heuristic: if AdcaRegs.ADCRESULT0 was written CAPTURE_SAMPLES times then last element in adcBuffer should be nonzero.
           This is not guaranteed (if waveform crosses zero exactly), so prefer using EDMA TC interrupt. */
        if (adcBuffer[CAPTURE_SAMPLES - 1] != 0) {
            break;
        }
        DELAY_US(poll_interval_us);
        waited += poll_interval_us;
    }

    /* Small pause to ensure all writes complete */
    DELAY_US(200);

    /* Signal capture done */
    {
        const char *msg = "CAPTURE_DONE\n";
        const char *q = msg;
        while (*q) scia_send_byte_blocking((unsigned char)*q++);
    }

    /* Dump buffer */
    dump_buffer_over_uart_with_header(CAPTURE_SAMPLES);
}

void dump_buffer_over_uart_with_header(uint32_t n)
{
    const char *hdr = "CAPTURE_BIN\n";
    const char *p = hdr;
    while (*p) scia_send_byte_blocking((unsigned char)*p++);

    /* Toggle LED briefly as indicator */
    GpioDataRegs.GPACLEAR.bit.GPIO31 = 1;
    DELAY_US(1000);
    GpioDataRegs.GPASET.bit.GPIO31 = 1;

    /* Send binary samples: LSB then MSB */
    for (uint32_t i = 0U; i < n; ++i) {
        uint16_t v = adcBuffer[i];
        scia_send_byte_blocking((unsigned char)(v & 0xFF));
        scia_send_byte_blocking((unsigned char)(v >> 8));
    }

    const char *endm = "\nCAPTURE_END\n";
    p = endm;
    while (*p) scia_send_byte_blocking((unsigned char)*p++);
}

/* ---------------------- MAIN ---------------------- */
int main(void)
{
#ifdef _FLASH
    memcpy(&RamfuncsRunStart, &RamfuncsLoadStart, (size_t)&RamfuncsLoadSize);
#endif

    InitSysCtrl();
    DINT;
    InitPieCtrl();
    InitPieVectTable();

    /* Initialize ADC and SCIA pins/peripheral */
    initADC_for_epwm_trigger();
    initSCIA_and_pins(DUMP_BAUDRATE);

    /* Initialize ePWM to generate 1MHz SOCA */
    initEPWM_for_1MHz_SOCA();

    /* Initialize EDMA for ADC->RAM transfer (user may need to replace with SDK DMA helper calls) */
    initEDMA_for_adc_to_ram();

    /* Small delay for everything to stabilize */
    DELAY_US(1000);

    /* Start the capture (arm EDMA, start ePWM if needed) and wait for completion */
    start_capture_and_wait();

    /* Halt so you can inspect terminal */
    for (;;) { __asm(" NOP"); }

    return 0;
}
