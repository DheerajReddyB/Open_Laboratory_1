// epwm1_adca_capture_clean_fixed.c
// ePWM1 SOCA -> ADCA SOC0 -> RAM -> SCIA binary dump
// Fixed: removed IER usage, replaced NOP, removed unsafe shift.
// Drop-in for TI C2000 F28379D (CCS). C89-compatible.

#include <stdint.h>
#include <stdbool.h>
#include <string.h>

#include "F28x_Project.h"

#ifndef ADCTRIG_EPWM1_SOCA
  #define ADCTRIG_EPWM1_SOCA 5U
#endif

/* -------- CONFIG -------- */
#define CAPTURE_SAMPLES   (1024U)
#define ADC_CHANNEL       0x0EU    /* ADCIN14 */
#define DUMP_BAUDRATE     115200U

#define SYSCLK_HZ         200000000UL
#define SAMPLE_RATE       500000UL
#define EPWM_TBPRD        ((uint16_t)((SYSCLK_HZ / SAMPLE_RATE) - 1U))
#define ADC_SOC_ACQPS     14U
/* ------------------------ */

static volatile uint16_t adcBuffer[CAPTURE_SAMPLES];
static volatile uint32_t sampleIndex = 0U;
static volatile bool capture_done = false;

/* Forward declarations */
void initSCIA_blocking(uint32_t baud);
void scia_send_byte_blocking(unsigned char b);
void initSCIA_and_pins(uint32_t baud);
void initEPWM1_for_sampling(uint16_t tbprd);
void initADC_for_epwm_soc0(void);
__interrupt void adca_isr(void);
void dump_buffer_over_uart_with_header(void);

/* ---------------- SCIA ---------------- */
void initSCIA_blocking(uint32_t baud)
{
    EALLOW;
    SciaRegs.SCICCR.all = 0x0007;   /* 8-bit, 1 stop, no parity */
    SciaRegs.SCICTL1.all = 0x0003;  /* SW reset released later */
    SciaRegs.SCICTL2.bit.TXINTENA = 1;
    SciaRegs.SCICTL2.bit.RXBKINTENA = 1;

    if (baud == 115200U) {
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = 53U;
    } else if (baud == 921600U) {
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = 6U;
    } else {
        uint32_t scil = (50000000UL / (16UL * baud));
        if (scil) scil -= 1U;
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = (uint16_t)scil;
    }

    SciaRegs.SCICTL1.all = 0x0023;  /* release from reset */
    EDIS;
}

void scia_send_byte_blocking(unsigned char b)
{
    SciaRegs.SCITXBUF.all = b;
    DELAY_US(200);
}

void initSCIA_and_pins(uint32_t baud)
{
    EALLOW;
    /* Route SCIA to GPIO42/43 (example) */
    GpioCtrlRegs.GPBMUX1.bit.GPIO42  = 3;
    GpioCtrlRegs.GPBMUX1.bit.GPIO43  = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO42 = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO43 = 3;

    /* LED pin: set direction (GPIO31 plain GPIO) */
    GpioCtrlRegs.GPADIR.bit.GPIO31 = 1;
    GpioDataRegs.GPASET.bit.GPIO31 = 1;
    EDIS;

    initSCIA_blocking(baud);

    /* Triple HELLO (C89-style loop) */
    {
        const char *hello = "HELLO\n";
        int rep;
        for (rep = 0; rep < 3; ++rep) {
            const char *p = hello;
            while (*p) scia_send_byte_blocking((unsigned char)*p++);
            DELAY_US(20000);
        }
    }
}

/* ---------------- ePWM1 ---------------- */
void initEPWM1_for_sampling(uint16_t tbprd)
{
    EALLOW;
    EPwm1Regs.TBCTL.bit.PHSEN = TB_DISABLE;
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_COUNT_UP;
    EPwm1Regs.TBPRD = tbprd;
    EPwm1Regs.TBCTL.bit.HSPCLKDIV = TB_DIV1;
    EPwm1Regs.TBCTL.bit.CLKDIV = TB_DIV1;
    EPwm1Regs.TBCTL.bit.SYNCOSEL = TB_CTR_ZERO;

    EPwm1Regs.ETSEL.bit.SOCAEN = 1;
    EPwm1Regs.ETSEL.bit.SOCASEL = ET_CTR_ZERO;
    EPwm1Regs.ETPS.bit.SOCAPRD = ET_1ST;
    EDIS;
}

/* ---------------- ADCA init ---------------- */
void initADC_for_epwm_soc0(void)
{
    EALLOW;
    AdcaRegs.ADCCTL2.bit.PRESCALE = 6;
    AdcbRegs.ADCCTL2.bit.PRESCALE = 6;

    AdcSetMode(ADC_ADCA, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);
    AdcSetMode(ADC_ADCB, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);

    AdcaRegs.ADCCTL1.bit.INTPULSEPOS = 1;
    AdcaRegs.ADCCTL1.bit.ADCPWDNZ = 1;
    DELAY_US(1000);

    AdcaRegs.ADCSOC0CTL.bit.CHSEL = ADC_CHANNEL;
    AdcaRegs.ADCSOC0CTL.bit.ACQPS = ADC_SOC_ACQPS;
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = ADCTRIG_EPWM1_SOCA;

    AdcaRegs.ADCINTSEL1N2.bit.INT1SEL = 0; /* EOC0 */
    AdcaRegs.ADCINTSEL1N2.bit.INT1E = 1;
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;
    EDIS;

    /* Hook ISR */
    EALLOW;
    PieVectTable.ADCA1_INT = &adca_isr;
    EDIS;

    /* Enable PIE for ADCA INT1 */
    PieCtrlRegs.PIEIER1.bit.INTx1 = 1;

    /* Note: do NOT touch IER here; we'll enable global interrupts later via EINT */
}

/* ---------------- ISR ---------------- */
__interrupt void adca_isr(void)
{
    uint16_t v = (uint16_t)AdcaResultRegs.ADCRESULT0;

    if (sampleIndex < CAPTURE_SAMPLES) {
        adcBuffer[sampleIndex] = v;
        sampleIndex++;
    }

    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

    if (sampleIndex >= CAPTURE_SAMPLES) {
        EALLOW;
        EPwm1Regs.ETSEL.bit.SOCAEN = 0;
        AdcaRegs.ADCINTSEL1N2.bit.INT1E = 0;
        PieCtrlRegs.PIEIER1.bit.INTx1 = 0;
        EDIS;
        capture_done = true;
    }

    PieCtrlRegs.PIEACK.all = PIEACK_GROUP1;
}

/* ---------------- Dump ---------------- */
void dump_buffer_over_uart_with_header(void)
{
    const char *hdr = "CAPTURE_DONE\n";
    const char *p = hdr;
    while (*p) scia_send_byte_blocking((unsigned char)*p++);

    /* blink */
    GpioDataRegs.GPACLEAR.bit.GPIO31 = 1;
    DELAY_US(1000);
    GpioDataRegs.GPASET.bit.GPIO31 = 1;

    {
        uint32_t i;
        for (i = 0U; i < sampleIndex; ++i) {
            uint16_t val = adcBuffer[i];
            scia_send_byte_blocking((unsigned char)(val & 0xFF));
            scia_send_byte_blocking((unsigned char)(val >> 8));
        }
    }

    const char *endm = "\nCAPTURE_END\n";
    p = endm;
    while (*p) scia_send_byte_blocking((unsigned char)*p++);
}

/* ---------------- main ---------------- */
int main(void)
{
#ifdef _FLASH
    memcpy(&RamfuncsRunStart, &RamfuncsLoadStart, (size_t)&RamfuncsLoadSize);
#endif

    InitSysCtrl();
    DINT;
    InitPieCtrl();
    InitPieVectTable();

    initSCIA_and_pins(DUMP_BAUDRATE);

    {
        const char *msg = "CAPTURE_STARTED\n";
        const char *q = msg;
        while (*q) scia_send_byte_blocking((unsigned char)*q++);
    }

    /* Ensure GPIO31 is output (LED) - do not touch GPAMUX bit dangerously */
    EALLOW;
    GpioCtrlRegs.GPADIR.bit.GPIO31 = 1;
    GpioDataRegs.GPASET.bit.GPIO31 = 1;
    EDIS;

    initEPWM1_for_sampling((uint16_t)EPWM_TBPRD);
    initADC_for_epwm_soc0();

    sampleIndex = 0U;
    capture_done = false;

    /* Enable global interrupts (PIE bits already set above) */
    EINT;
    ERTM;

    while (!capture_done) {
        asm(" NOP"); /* safe single-instruction idle */
    }

    dump_buffer_over_uart_with_header();

    for (;;) {
        asm(" NOP");
    }

    return 0;
}
