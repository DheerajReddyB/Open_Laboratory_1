// diagnostic_epwm_adca.c
// Diagnostic program for F28379D: prints EPWM TBCTR, forces software SOCs to read ADC,
// then tries ePWM-triggered capture. Use in fresh CCS project.

#include "F28x_Project.h"

#ifndef ADCTRIG_EPWM1_SOCA
  #define ADCTRIG_EPWM1_SOCA 5U
#endif

#define CAPTURE_SAMPLES   1024U
#define ADC_CHANNEL       14U    // ADCIN14
#define DUMP_BAUDRATE     115200U

#define SYSCLK_HZ         200000000UL
#define SAMPLE_RATE       500000UL
#define EPWM_TBPRD        ((uint16_t)((SYSCLK_HZ / SAMPLE_RATE) - 1U))
#define ADC_SOC_ACQPS     14U

volatile uint16_t adcBuffer[CAPTURE_SAMPLES];
volatile uint32_t sampleIndex = 0U;
volatile uint16_t capture_done = 0U;

/* portable SCIA send */
void scia_send_byte(unsigned char b)
{
    SciaRegs.SCITXBUF.all = (uint16_t)b;
    DELAY_US(80);
}

void scia_print(const char *s)
{
    while (*s) scia_send_byte((unsigned char)*s++);
}

/* print unsigned integer as decimal (simple) */
void scia_print_uint(uint32_t v)
{
    char buf[12];
    int i = 0;
    if (v == 0) { scia_send_byte('0'); return; }
    while (v) {
        buf[i++] = '0' + (v % 10);
        v /= 10;
    }
    while (i--) scia_send_byte((unsigned char)buf[i]);
}

/* ---- SCIA init and pins ---- */
void initSCIA(void)
{
    EALLOW;
    /* route scia to gp42/43 typical */
    GpioCtrlRegs.GPBMUX1.bit.GPIO42  = 3;
    GpioCtrlRegs.GPBMUX1.bit.GPIO43  = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO42 = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO43 = 3;

    SciaRegs.SCICCR.all = 0x07;
    SciaRegs.SCICTL1.all = 0x03;
    SciaRegs.SCICTL2.bit.TXINTENA = 1;

    SciaRegs.SCIHBAUD.all = 0x0000;
    SciaRegs.SCILBAUD.all = 53; /* ~115200 @50MHz LSPCLK */

    SciaRegs.SCICTL1.all = 0x0023;
    EDIS;

    scia_print("HELLO\nHELLO\nHELLO\n");
}

/* ---- ePWM simple init ---- */
void initEPWM1_basic(uint16_t tbprd)
{
    EALLOW;
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_COUNT_UP;
    EPwm1Regs.TBPRD = tbprd;
    EPwm1Regs.TBCTL.bit.HSPCLKDIV = TB_DIV1;
    EPwm1Regs.TBCTL.bit.CLKDIV = TB_DIV1;
    /* SOCA on up-count zero */
    EPwm1Regs.ETSEL.bit.SOCAEN = 1;
    EPwm1Regs.ETSEL.bit.SOCASEL = ET_CTR_ZERO;
    EPwm1Regs.ETPS.bit.SOCAPRD = ET_1ST;
    EDIS;
}

/* ---- ADC init for SOC0 but keep TRIGSEL configurable ---- */
void initADC_minimal(void)
{
    EALLOW;
    AdcaRegs.ADCCTL2.bit.PRESCALE = 6;
    AdcSetMode(ADC_ADCA, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);
    AdcaRegs.ADCCTL1.bit.INTPULSEPOS = 1;
    AdcaRegs.ADCCTL1.bit.ADCPWDNZ = 1;
    DELAY_US(1000);

    AdcaRegs.ADCSOC0CTL.bit.CHSEL = ADC_CHANNEL;
    AdcaRegs.ADCSOC0CTL.bit.ACQPS = ADC_SOC_ACQPS;
    /* do NOT set TRIGSEL here for forced-SOC test, we'll set later for EPWM test */
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = ADCTRIG_SW_FORCE; /* temporarily set */
    AdcaRegs.ADCINTSEL1N2.bit.INT1SEL = 0;
    AdcaRegs.ADCINTSEL1N2.bit.INT1E = 1;
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;
    EDIS;
}

/* ---- ADCA ISR for EPWM capture path ---- */
interrupt void adca_isr(void)
{
    uint16_t v = (uint16_t)AdcaResultRegs.ADCRESULT0;
    if (sampleIndex < CAPTURE_SAMPLES) {
        adcBuffer[sampleIndex++] = v;
    }
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;
    PieCtrlRegs.PIEACK.all = PIEACK_GROUP1;

    if (sampleIndex >= CAPTURE_SAMPLES) {
        EPwm1Regs.ETSEL.bit.SOCAEN = 0; /* stop */
        capture_done = 1;
    }
}

/* ---------- Force software SOCs and print results ---------- */
void do_software_socs_and_print(int n)
{
    int k;
    for (k = 0; k < n; ++k) {
        /* Force SOC0 */
        AdcaRegs.ADCSOCFRC1.all = 0x1;
        /* Wait EOC: poll ADCINT1 or EOC0 */
        while (AdcaRegs.ADCINTFLG.bit.ADCINT1 == 0) {}
        uint16_t r = (uint16_t)AdcaResultRegs.ADCRESULT0;
        /* clear flag */
        AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

        scia_print("DIAG: SW-SOC read = ");
        scia_print_uint(r);
        scia_print("\n");
        DELAY_US(500); /* small gap */
    }
}

/* ------------ main ------------ */
int main(void)
{
#ifdef _FLASH
    memcpy(&RamfuncsRunStart, &RamfuncsLoadStart, (size_t)&RamfuncsLoadSize);
#endif

    InitSysCtrl();
    DINT;
    InitPieCtrl();
    InitPieVectTable();

    /* ensure EPWM1 clock domain ON and stop TBCLK while configuring */
    EALLOW;
    CpuSysRegs.PCLKCR2.bit.EPWM1 = 1;
    CpuSysRegs.PCLKCR0.bit.TBCLKSYNC = 0;
    EDIS;

    initSCIA();
    scia_print("CAPTURE_STARTED\n");

    /* LED */
    EALLOW;
    GpioCtrlRegs.GPADIR.bit.GPIO31 = 1;
    GpioDataRegs.GPASET.bit.GPIO31 = 1;
    EDIS;

    /* init ADC minimal for SW forcing test */
    initADC_minimal();

    /* ------------ DIAG: print EPWM regs before starting TBCLK ------------ */
    scia_print("DIAG: EPWM_TBPRD = ");
    scia_print_uint(EPwm1Regs.TBPRD);
    scia_print("\n");

    scia_print("DIAG: TBCTR (before start) = ");
    scia_print_uint(EPwm1Regs.TBCTR);
    scia_print("\n");

    /* Start TBCLK so EPWM runs for diagnostic printing */
    EALLOW;
    CpuSysRegs.PCLKCR0.bit.TBCLKSYNC = 1;
    EDIS;

    /* Wait short and print a few TBCTR values so we know it runs */
    {
        int i;
        for (i = 0; i < 5; ++i) {
            DELAY_US(200000); /* 200 ms */
            scia_print("DIAG: TBCTR = ");
            scia_print_uint(EPwm1Regs.TBCTR);
            scia_print("\n");
        }
    }

    /* ------------ DIAG: force SW SOCs to verify ADC hardware reading ---------- */
    scia_print("DIAG: forcing 8 software SOCs to read ADC result (proves ADC hw + wiring)\n");
    do_software_socs_and_print(8);

    /* If ADC prints sensible numbers (not all zeros or max), ADC hardware and wiring ok.
       Now configure SOC0 trigger back to EPWM1 SOCA and try full capture. */

    /* Reconfigure SOC0 TRIG to EPWM1 SOCA and hook ISR */
    EALLOW;
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = ADCTRIG_EPWM1_SOCA;
    AdcaRegs.ADCINTSEL1N2.bit.INT1SEL = 0; /* EOC0 */
    AdcaRegs.ADCINTSEL1N2.bit.INT1E = 1;
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

    /* Hook ISR: vector name ADCA1_INT common, adjust if different in your headers */
    PieVectTable.ADCA1_INT = &adca_isr;
    PieCtrlRegs.PIEIER1.bit.INTx1 = 1;

    /* Reset counters and enable interrupts */
    sampleIndex = 0U;
    capture_done = 0U;
    EDIS;

    /* re-init EPWM period and enable SOCA */
    initEPWM1_basic(EPWM_TBPRD);

    /* Restart TBCLK sync to start ePWM */
    EALLOW;
    CpuSysRegs.PCLKCR0.bit.TBCLKSYNC = 1;
    EDIS;

    EINT;
    ERTM;

    /* Wait for capture_done (ISR will set). We'll also timeout in case nothing happens. */
    {
        uint32_t timeout = 0;
        while (!capture_done && (timeout < 10000)) { /* ~10000 * small delay ~ some seconds */
            DELAY_US(2000);
            timeout++;
        }
        if (!capture_done) {
            scia_print("DIAG: EPWM-triggered capture did NOT finish (timeout)\n");
            scia_print("DIAG: Last TBCTR = ");
            scia_print_uint(EPwm1Regs.TBCTR);
            scia_print("\n");
        } else {
            scia_print("CAPTURE_DONE\n");
            /* send binary dump header and samples */
            scia_print("DIAG: dumping binary (LSB MSB)...\n");
            scia_print("CAPTURE_DONE\n");
            uint32_t i;
            for (i = 0; i < sampleIndex; ++i) {
                uint16_t v = adcBuffer[i];
                scia_send_byte((unsigned char)(v & 0xFF));
                scia_send_byte((unsigned char)(v >> 8));
            }
            scia_print("\nCAPTURE_END\n");
        }
    }

    for(;;) asm(" NOP");
    return 0;
}
