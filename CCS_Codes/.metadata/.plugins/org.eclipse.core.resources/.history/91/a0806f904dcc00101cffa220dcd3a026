//
// f28379d_epwm_1MSPS_capture.c
// TRUE 1 MSPS ADC capture using ePWM1 SOCA trigger → RAM → UART dump
//


#include <stdbool.h>
#include <string.h>
#include "F28x_Project.h"
#include <stdint.h>

/* ---------- CONFIG ---------- */
#define CAPTURE_SAMPLES  1024          // capture buffer size
#define ADC_CHANNEL      0x0E          // ADCIN14
#define BAUDRATE         115200
#define TBPRD_1MHZ       99            // gives 1 MHz trigger
/* ---------------------------- */

static volatile uint16_t adcBuffer[CAPTURE_SAMPLES];
static volatile uint32_t sampleIndex = 0;

/* UART prototypes */
void init_scia(uint32_t baud);
void scia_send(uint8_t c);
void uart_print(const char *msg);

/* EPWM + ADC prototypes */
void init_epwm_1mhz_trigger(void);
void init_adc_epwm_triggered(void);

/* Dump data */
void dump_buffer_uart(void);


/* ---------------- UART ---------------- */
void init_scia(uint32_t baud)
{
    EALLOW;

    GpioCtrlRegs.GPBMUX1.bit.GPIO42 = 3;
    GpioCtrlRegs.GPBMUX1.bit.GPIO43 = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO42 = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO43 = 3;

    SciaRegs.SCICCR.all = 0x0007;
    SciaRegs.SCICTL1.all = 0x0003;

    // BAUD -> LSPCLK = 50 MHz
    if (baud == 115200)
    {
        SciaRegs.SCIHBAUD.all = 0;
        SciaRegs.SCILBAUD.all = 53;
    }
    else
    {
        uint32_t scil = (50000000 / (baud * 16)) - 1;
        SciaRegs.SCIHBAUD.all = 0;
        SciaRegs.SCILBAUD.all = scil;
    }

    SciaRegs.SCICTL1.all = 0x0023;  // release reset
    EDIS;
}

void scia_send(uint8_t c)
{
    SciaRegs.SCITXBUF.all = c;
    DELAY_US(80);
}

void uart_print(const char *msg)
{
    while (*msg) scia_send(*msg++);
}


/* ---------------- EPWM: 1 MHz trigger ---------------- */
void init_epwm_1mhz_trigger(void)
{
    EALLOW;

    // Freeze
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_FREEZE;

    // TBCLK = SYSCLK/2 = 200MHz/2 = 100MHz
    EPwm1Regs.TBCTL.bit.CLKDIV = 0;     // /1
    EPwm1Regs.TBCTL.bit.HSPCLKDIV = 0;  // /1

    EPwm1Regs.TBPRD = TBPRD_1MHZ;       // 99 → 1 MHz

    EPwm1Regs.TBCTL.bit.CTRMODE = TB_COUNT_UP;

    // SOCA at CTR=0
    EPwm1Regs.ETSEL.bit.SOCAEN = 1;
    EPwm1Regs.ETSEL.bit.SOCASEL = ET_CTR_ZERO;
    EPwm1Regs.ETPS.bit.SOCAPRD = ET_1ST;

    EDIS;
}


/* ---------------- ADC: triggered by ePWM1 SOCA ---------------- */
void init_adc_epwm_triggered(void)
{
    EALLOW;

    AdcaRegs.ADCCTL2.bit.PRESCALE = 6;   // ADCCLK = 50 MHz
    AdcSetMode(ADC_ADCA, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);

    AdcaRegs.ADCCTL1.bit.ADCPWDNZ = 1;
    DELAY_US(1000);

    // SOC0 config
    AdcaRegs.ADCSOC0CTL.bit.CHSEL = ADC_CHANNEL;
    AdcaRegs.ADCSOC0CTL.bit.ACQPS = 14; // short ACQ window for speed

    // TRIGSEL = ePWM1 SOCA
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = 5; // ADCTRIG_EPWM1_SOCA typically=5

    AdcaRegs.ADCINTSEL1N2.bit.INT1SEL = 0; // EOC0
    AdcaRegs.ADCINTSEL1N2.bit.INT1E = 1;

    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

    EDIS;
}


/* ---------------- Dump buffer ---------------- */
void dump_buffer_uart(void)
{
    uart_print("CAPTURE_DONE\n");

    for (uint32_t i=0; i<CAPTURE_SAMPLES; i++)
    {
        uint16_t v = adcBuffer[i];
        scia_send(v & 0xFF);
        scia_send(v >> 8);
    }

    uart_print("\nCAPTURE_END\n");
}


/* ---------------- MAIN ---------------- */
int main(void)
{
    InitSysCtrl();
    DINT;
    InitPieCtrl();
    InitPieVectTable();

    init_scia(BAUDRATE);

    uart_print("HELLO\nHELLO\nHELLO\n");
    uart_print("CAPTURE_STARTED\n");

    init_epwm_1mhz_trigger();
    init_adc_epwm_triggered();

    // Start PWM
    EALLOW;
    CpuSysRegs.PCLKCR0.bit.TBCLKSYNC = 1;
    EDIS;

    sampleIndex = 0;

    // Capture loop: wait for ADCINT1 at 1 MHz
    while (sampleIndex < CAPTURE_SAMPLES)
    {
        if (AdcaRegs.ADCINTFLG.bit.ADCINT1)
        {
            AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;
            adcBuffer[sampleIndex++] = AdcaResultRegs.ADCRESULT0;
        }
    }

    dump_buffer_uart();

    while (1) { }

    return 0;
}
