// epwm1_socA_polled_capture_dump.c
// ePWM1 SOCA -> ADCA SOC0 -> polled capture -> RAM -> SCIA binary dump
// C89-compatible, no ISR, no DMA. Ready to paste into a NEW CCS source file.
//
// Usage:
//  1) Create new C file in your CCS project and paste this file.
//  2) Exclude example/demo files from build if present.
//  3) Build & flash. Open terminal (or run python capture) BEFORE reset.
//  4) Reset board: you'll see HELLO x3, INIT_DONE, CAPTURE_STARTED, then CAPTURE_DONE and binary.
//
// Author: ChatGPT (adapted for F28379D)

#include <stdint.h>
#include <stdbool.h>
#include <string.h>
#include <stdio.h>

#include "F28x_Project.h"
#include "ti_ascii.h"

/* ---------------- CONFIGURATION ---------------- */
#define CAPTURE_SAMPLES   (1024U)   /* number of samples to collect (power-of-2 recommended) */
#define ADC_CHANNEL       14U       /* ADCIN14 (use numeric channel) */
#define DUMP_BAUDRATE     115200U

/* System / ePWM settings (tune TBPRD for sample rate)
   Typical SYSCLK = 200e6, TBCLK_DIV = 4 -> TBCLK = 50 MHz.
   sample_rate = TBCLK / (TBPRD + 1)
   TBPRD_DEFAULT = 99 -> 50e6 / 100 = 500000 Hz (500 kS/s)
*/
#define SYSCLK_HZ         (200000000.0)
#define TBCLK_DIV         4U
#define TBPRD_DEFAULT     99U

/* ADC settings */
#define ADC_PRESCALE      6U    /* ADCCLK = SYSCLK / (AD C prescale-based divider) */
#define ADC_ACQPS         25U   /* ACQPS -> sample window = ACQPS + 1 ADC cycles */

/* Delay before dumping (us) to let host be ready */
#define PRE_DUMP_DELAY_US (2000000U)   /* 2 s */

/* ---------------- globals ---------------- */
static volatile uint16_t adcBuffer[CAPTURE_SAMPLES];
static volatile uint32_t sampleIndex = 0U;

/* Forward prototypes */
void initSCIA_blocking(uint32_t baud);
void scia_send_byte_blocking(unsigned char b);
void initSCIA_and_pins(uint32_t baud);

void initADC_for_epwm_soc0(void);
void initEPWM1_for_soctrig(uint32_t tbprd);

void dump_buffer_over_uart_with_header(uint32_t n);

/* ---------- SCIA helpers ---------- */
void initSCIA_blocking(uint32_t baud)
{
    EALLOW;
    SciaRegs.SCICCR.all = 0x0007;  /* 8-bit, 1 stop, no parity */
    SciaRegs.SCICTL1.all = 0x0003; /* basic reset state */
    SciaRegs.SCICTL2.bit.TXINTENA = 1;
    SciaRegs.SCICTL2.bit.RXBKINTENA = 1;
    EDIS;

    /* Baud approximations for LSPCLK ~50 MHz */
    if (baud == 115200U) {
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = 53U;
    } else if (baud == 921600U) {
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = 6U;
    } else {
        uint32_t scil = (50000000UL / (16UL * baud));
        if (scil) scil -= 1U;
        SciaRegs.SCIHBAUD.all = 0x0000;
        SciaRegs.SCILBAUD.all = (uint16_t)scil;
    }

    SciaRegs.SCICTL1.all = 0x0023; /* release SCI from reset */
}

/* Blocking send with short delay to avoid first-byte loss */
void scia_send_byte_blocking(unsigned char b)
{
    SciaRegs.SCITXBUF.all = b;
    DELAY_US(200);
}

void initSCIA_and_pins(uint32_t baud)
{
    int rep;
    EALLOW;
    /* Route SCIA to GPIO42/43 (TX/RX) */
    GpioCtrlRegs.GPBMUX1.bit.GPIO42  = 3;
    GpioCtrlRegs.GPBMUX1.bit.GPIO43  = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO42 = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO43 = 3;

    /* LED pin as output (GPIO31) */
    GpioCtrlRegs.GPADIR.bit.GPIO31 = 1;
    GpioDataRegs.GPADAT.bit.GPIO31 = 1; /* LED off */
    EDIS;

    initSCIA_blocking(baud);

    /* Triple HELLO */
    {
        const char *hello = "HELLO\n";
        const char *p;
        for (rep = 0; rep < 3; ++rep) {
            p = hello;
            while (*p) scia_send_byte_blocking((unsigned char)*p++);
            DELAY_US(20000);
        }
    }
}

/* ---------- ePWM1 init: generate SOCA on counter-zero ---------- */
void initEPWM1_for_soctrig(uint32_t tbprd)
{
    EALLOW;
    /* time-base control: up-count, no phase, divide = 1 */
    EPwm1Regs.TBCTL.bit.CLKDIV = TB_DIV1;
    EPwm1Regs.TBCTL.bit.HSPCLKDIV = TB_DIV1;
    EPwm1Regs.TBCTL.bit.PHSEN = TB_DISABLE;
    EPwm1Regs.TBPRD = tbprd;

    /* generate SOCA on zero event */
    EPwm1Regs.ETSEL.bit.SOCAEN = 1;
    EPwm1Regs.ETSEL.bit.SOCASEL = ET_CTR_ZERO; /* SOCA on counter zero */
    EPwm1Regs.ETPS.bit.SOCAPRD = ET_1ST;       /* first event */

    /* keep counter stopped until we start it */
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_DISABLE;
    EDIS;
}

/* ---------- ADC init for ePWM SOCA trigger ---------- */
void initADC_for_epwm_soc0(void)
{
    EALLOW;
    /* prescale */
    AdcaRegs.ADCCTL2.bit.PRESCALE = ADC_PRESCALE;
    AdcbRegs.ADCCTL2.bit.PRESCALE = ADC_PRESCALE;

    /* 12-bit single-ended */
    AdcSetMode(ADC_ADCA, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);
    AdcSetMode(ADC_ADCB, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);

    /* late sampling + power up */
    AdcaRegs.ADCCTL1.bit.INTPULSEPOS = 1;
    AdcaRegs.ADCCTL1.bit.ADCPWDNZ = 1;
    DELAY_US(1000); /* short delay for power up */

    /* SOC0 -> ADCIN14 */
    AdcaRegs.ADCSOC0CTL.bit.CHSEL = ADC_CHANNEL;
    AdcaRegs.ADCSOC0CTL.bit.ACQPS = ADC_ACQPS;

    /* TRIGSEL: prefer symbolic ADCTRIG_EPWM1_SOCA; if not defined, fallback numeric (6) */
#ifdef ADCTRIG_EPWM1_SOCA
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = ADCTRIG_EPWM1_SOCA;
#elif defined(ADCTRIG1)
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = ADCTRIG1;
#else
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = 6U;
#endif

    /* map ADCINT1 to EOC0 */
    AdcaRegs.ADCINTSEL1N2.bit.INT1SEL = 0; /* EOC0 */
    AdcaRegs.ADCINTSEL1N2.bit.INT1E = 1;
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

    EDIS;
}

/* ---------- Dump buffer (binary) with ASCII header/footer ---------- */
void dump_buffer_over_uart_with_header(uint32_t n)
{
    const char *hdr = "CAPTURE_DONE\n";
    const char *p = hdr;
    while (*p) scia_send_byte_blocking((unsigned char)*p++);

    /* small LED blink */
    GpioDataRegs.GPACLEAR.bit.GPIO31 = 1;
    DELAY_US(1000);
    GpioDataRegs.GPASET.bit.GPIO31 = 1;

    /* send binary samples little-endian (LSB then MSB) */
    {
        uint32_t i;
        for (i = 0U; i < n; ++i) {
            uint16_t v = adcBuffer[i];
            scia_send_byte_blocking((unsigned char)(v & 0xFF));
            scia_send_byte_blocking((unsigned char)(v >> 8));
        }
    }

    const char *endm = "\nCAPTURE_END\n";
    p = endm;
    while (*p) scia_send_byte_blocking((unsigned char)*p++);
}

/* ---------- main ---------- */
int main(void)
{
#ifdef _FLASH
    memcpy(&RamfuncsRunStart, &RamfuncsLoadStart, (size_t)&RamfuncsLoadSize);
#endif

    uint32_t i;
    uint32_t tbprd = TBPRD_DEFAULT;
    double tbclk = SYSCLK_HZ / (double)TBCLK_DIV;
    double sample_rate = tbclk / (double)(tbprd + 1U);

    /* basic init */
    InitSysCtrl();
    DINT;
    InitPieCtrl();
    InitPieVectTable();

    /* init SCIA and pins */
    initSCIA_and_pins(DUMP_BAUDRATE);

    /* debug mark: INIT_DONE */
    {
        const char *m = "INIT_DONE\n";
        const char *q = m;
        while (*q) scia_send_byte_blocking((unsigned char)*q++);
        DELAY_US(200000); /* brief pause so host can be ready */
    }

    /* init ADC and ePWM */
    initADC_for_epwm_soc0();
    initEPWM1_for_soctrig(tbprd);

    /* announce start and sample-rate */
    {
        char tbuf[128];
        int nlen;
        nlen = sprintf(tbuf, "CAPTURE_STARTED\n");
        for (i = 0; i < (uint32_t)nlen; ++i) scia_send_byte_blocking((unsigned char)tbuf[i]);
        nlen = sprintf(tbuf, "Using ePWM-derived sample rate: %.0f Hz (SYSCLK=%.0f, TBCLK_DIV=%u, TBPRD=%u)\n",
                       sample_rate, SYSCLK_HZ, TBCLK_DIV, tbprd);
        for (i = 0; i < (uint32_t)nlen; ++i) scia_send_byte_blocking((unsigned char)tbuf[i]);
    }

    /* clear buffer */
    for (i = 0; i < CAPTURE_SAMPLES; ++i) adcBuffer[i] = 0U;
    sampleIndex = 0U;

    /* start ePWM (this begins generating SOCA triggers) */
    EALLOW;
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_COUNT_UP;
    EDIS;

    /* capture loop: poll ADCINT1, read result, clear flag, store sample */
    while (sampleIndex < CAPTURE_SAMPLES) {
        /* busy-wait until EOC0 (ADCINT1 set) */
        while (AdcaRegs.ADCINTFLG.bit.ADCINT1 == 0) {
            /* tight poll - optional timeout could be added */
        }

        /* read result */
        {
            uint16_t s = (uint16_t)AdcaResultRegs.ADCRESULT0;
            adcBuffer[sampleIndex++] = s;
        }

        /* clear flag for next conversion */
        AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

        /* optional small visual feedback every 256 samples */
        if ((sampleIndex & 0xFF) == 0) {
            GpioDataRegs.GPATOGGLE.bit.GPIO31 = 1;
        }
    }

    /* stop ePWM (optional) */
    EALLOW;
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_DISABLE;
    EDIS;

    /* allow host to be ready */
    if (PRE_DUMP_DELAY_US) DELAY_US(PRE_DUMP_DELAY_US);

    /* dump collected buffer */
    dump_buffer_over_uart_with_header(CAPTURE_SAMPLES);

    /* halt so you can inspect terminal */
    for (;;) { __asm(" NOP"); }

    return 0;
}
