// epwm1_adca_capture_scifix.c
// ePWM1 SOCA -> ADCA SOC0 -> RAM -> SCIA binary dump
// Fixed SCITXBUF usage to use .all (portable across TI headers)

#include "F28x_Project.h"

/* -------- CONFIG -------- */
#define CAPTURE_SAMPLES   1024U
#define ADC_CHANNEL       14U          /* ADCIN14 */
#define DUMP_BAUDRATE     115200U

#define SYSCLK_HZ         200000000UL
#define SAMPLE_RATE       500000UL     /* 500 kS/s */

#define EPWM_TBPRD        ((uint16_t)((SYSCLK_HZ / SAMPLE_RATE) - 1U))
#define ADC_SOC_ACQPS     14U
/* ------------------------ */

volatile uint16_t adcBuffer[CAPTURE_SAMPLES];
volatile uint16_t sampleIndex = 0;
volatile uint16_t capture_done = 0;

/* ---- SCIA send (fixed) ---- */
void scia_send_byte(unsigned char b)
{
    /* Use .all to write full register value — portable across header versions */
    SciaRegs.SCITXBUF.all = (uint16_t)b;
    DELAY_US(80);
}

void initSCIA(void)
{
    EALLOW;

    /* Map SCIA to GPIO42/43 (TX=42, RX=43) - common on F2837xD launchpads */
    GpioCtrlRegs.GPBMUX1.bit.GPIO42 = 3;
    GpioCtrlRegs.GPBMUX1.bit.GPIO43 = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO42 = 3;
    GpioCtrlRegs.GPBGMUX1.bit.GPIO43 = 3;

    SciaRegs.SCICCR.all = 0x07;    /* 1 stop, 8-bit, no parity */
    SciaRegs.SCICTL1.all = 0x03;   /* SW reset, RX/TX enable will be released later */
    SciaRegs.SCICTL2.bit.TXINTENA = 1;

    /* Baud approx for LSPCLK ~50MHz */
    SciaRegs.SCIHBAUD.all = 0x0000;
    SciaRegs.SCILBAUD.all = 53;    /* ~115200 @50MHz LSPCLK */

    SciaRegs.SCICTL1.all = 0x0023; /* release from reset */

    EDIS;

    /* HELLO messages */
    {
        const char *t = "HELLO\nHELLO\nHELLO\n";
        while (*t) scia_send_byte((unsigned char)*t++);
    }
}

/* ---- ePWM init ---- */
void initEPWM1(void)
{
    EALLOW;
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_COUNT_UP;  /* up count */
    EPwm1Regs.TBPRD = EPWM_TBPRD;
    EPwm1Regs.TBCTL.bit.HSPCLKDIV = TB_DIV1;
    EPwm1Regs.TBCTL.bit.CLKDIV = TB_DIV1;

    /* Enable SOCA on CTR = ZERO */
    EPwm1Regs.ETSEL.bit.SOCAEN = 1;
    EPwm1Regs.ETSEL.bit.SOCASEL = ET_CTR_ZERO;
    EPwm1Regs.ETPS.bit.SOCAPRD = ET_1ST;
    EDIS;
}

/* ---- ADCA ISR ---- */
interrupt void adca_isr(void)
{
    adcBuffer[sampleIndex] = AdcaResultRegs.ADCRESULT0;
    sampleIndex++;

    /* clear ADCINT1 flag and ack PIE */
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;
    PieCtrlRegs.PIEACK.all = PIEACK_GROUP1;

    if (sampleIndex >= CAPTURE_SAMPLES)
    {
        /* stop further triggers */
        EPwm1Regs.ETSEL.bit.SOCAEN = 0;
        capture_done = 1;
    }
}

/* ---- ADC init ---- */
void initADC(void)
{
    EALLOW;

    AdcaRegs.ADCCTL2.bit.PRESCALE = 6;  /* ADCCLK = SYSCLK/4 when PRESCALE=6 example */
    AdcSetMode(ADC_ADCA, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);
    AdcaRegs.ADCCTL1.bit.INTPULSEPOS = 1;
    AdcaRegs.ADCCTL1.bit.ADCPWDNZ = 1;
    DELAY_US(1000);

    /* SOC0 -> ADCIN14 */
    AdcaRegs.ADCSOC0CTL.bit.CHSEL = ADC_CHANNEL;
    AdcaRegs.ADCSOC0CTL.bit.ACQPS = ADC_SOC_ACQPS;
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = ADCTRIG_EPWM1_SOCA; /* usually 5, defined in headers */

    /* INT1 on EOC0 */
    AdcaRegs.ADCINTSEL1N2.bit.INT1SEL = 0;
    AdcaRegs.ADCINTSEL1N2.bit.INT1E = 1;
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

    EDIS;

    /* Hook ISR */
    EALLOW;
    /* Common name used in TI headers: ADCA1_INT — if your header uses another, replace this line */
    PieVectTable.ADCA1_INT = &adca_isr;
    EDIS;

    /* Enable PIE for ADCA INT1 and (we'll rely on EINT) */
    PieCtrlRegs.PIEIER1.bit.INTx1 = 1;
}

/* ---- main ---- */
int main(void)
{
#ifdef _FLASH
    memcpy(&RamfuncsRunStart, &RamfuncsLoadStart, (size_t)&RamfuncsLoadSize);
#endif

    InitSysCtrl();
    DINT;
    InitPieCtrl();
    InitPieVectTable();

    /* Ensure EPWM1 clock domain enabled and stop TBCLK until configured */
    EALLOW;
    CpuSysRegs.PCLKCR2.bit.EPWM1 = 1;
    CpuSysRegs.PCLKCR0.bit.TBCLKSYNC = 0;
    EDIS;

    /* Init SCIA and announce start */
    initSCIA();
    {
        const char *t = "CAPTURE_STARTED\n";
        while (*t) scia_send_byte((unsigned char)*t++);
    }

    /* LED output config */
    EALLOW;
    GpioCtrlRegs.GPADIR.bit.GPIO31 = 1;
    GpioDataRegs.GPASET.bit.GPIO31 = 1;
    EDIS;

    /* Init EPWM and ADC */
    initEPWM1();
    initADC();

    /* Start TB clocks */
    EALLOW;
    CpuSysRegs.PCLKCR0.bit.TBCLKSYNC = 1;
    EDIS;

    /* Reset counters */
    sampleIndex = 0;
    capture_done = 0;

    /* Enable global interrupts */
    EINT;
    ERTM;

    /* Wait for capture to complete (ISR sets capture_done) */
    while (!capture_done) asm(" NOP");

    /* Dump header */
    {
        const char *h = "CAPTURE_DONE\n";
        while (*h) scia_send_byte((unsigned char)*h++);
    }

    /* Binary LSB then MSB */
    {
        uint16_t i;
        for (i = 0; i < CAPTURE_SAMPLES; ++i) {
            uint16_t v = adcBuffer[i];
            scia_send_byte((unsigned char)(v & 0xFF));
            scia_send_byte((unsigned char)(v >> 8));
        }
    }

    /* Footer */
    {
        const char *f = "\nCAPTURE_END\n";
        while (*f) scia_send_byte((unsigned char)*f++);
    }

    for (;;) asm(" NOP");
}
