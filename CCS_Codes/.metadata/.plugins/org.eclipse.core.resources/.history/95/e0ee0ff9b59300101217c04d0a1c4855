#include "driverlib.h"
#include "device.h"
#include "dsp.h"

#define FFT_SIZE 256

// Align buffers for FFT
#pragma DATA_SECTION(input, "ramgs0");
#pragma DATA_SECTION(output, "ramgs1");

float32 input[FFT_SIZE];
float32 output[FFT_SIZE];

void main(void)
{
    Device_init();
    Device_initGPIO();

    // Fill input with a test sine wave
    for(int i = 0; i < FFT_SIZE; i++)
    {
        input[i] = sinf(2.0f * M_PI * 10.0f * i / FFT_SIZE);  // 10 Hz sine
    }

    // Run FFT (example: radix-2 FFT, using library function)
    RFFT_F32_STRUCT fft;
    RFFT_F32_STRUCT_Handle hnd = &fft;

    RFFT_f32_setInputPtr(hnd, input);
    RFFT_f32_setOutputPtr(hnd, output);
    RFFT_f32_setFFTSize(hnd, FFT_SIZE);

    RFFT_f32(hnd);

    while(1);
}
