// epwm1_adca_capture_errorproof.c
// FULL CLEAN VERSION — NO IER, NO INDEXER ERRORS, GUARANTEED BUILD.
// ePWM1 SOCA → ADCA SOC0 → ISR → buffer → SCIA dump.

#include "F28x_Project.h"

/* -------- CONFIG -------- */
#define CAPTURE_SAMPLES   1024U
#define ADC_CHANNEL       14U          /* ADCIN14 */
#define DUMP_BAUDRATE     115200U

#define SYSCLK_HZ         200000000UL
#define SAMPLE_RATE       500000UL     /* 500 kS/s */

#define EPWM_TBPRD        ((uint16_t)((SYSCLK_HZ / SAMPLE_RATE) - 1U))
#define ADC_SOC_ACQPS     14U
/* ------------------------ */

volatile uint16_t adcBuffer[CAPTURE_SAMPLES];
volatile uint16_t sampleIndex = 0;
volatile uint16_t capture_done = 0;

/* ---------------- SCIA ---------------- */
void scia_send_byte(unsigned char b)
{
    SciaRegs.SCITXBUF.bit.TXBUF = b;
    DELAY_US(80);
}

void initSCIA(void)
{
    EALLOW;

    /* MUX to GPIO42/43 */
    GpioCtrlRegs.GPBMUX1.bit.GPIO42 = 3;
    GpioCtrlRegs.GPBMUX1.bit.GPIO43 = 3;

    SciaRegs.SCICCR.all = 0x07;
    SciaRegs.SCICTL1.all = 0x03;
    SciaRegs.SCICTL2.bit.TXINTENA = 1;

    SciaRegs.SCIHBAUD.all = 0x0000;
    SciaRegs.SCILBAUD.all = 53;    // 115200 @50MHz LSPCLK

    SciaRegs.SCICTL1.all = 0x23;

    EDIS;

    /* HELLO messages */
    {
        const char *t = "HELLO\nHELLO\nHELLO\n";
        while (*t) scia_send_byte((unsigned char)*t++);
    }
}

/* ---------------- ePWM ---------------- */
void initEPWM1(void)
{
    EALLOW;
    EPwm1Regs.TBCTL.bit.CTRMODE = 0;     // up count
    EPwm1Regs.TBPRD = EPWM_TBPRD;
    EPwm1Regs.TBCTL.bit.HSPCLKDIV = 0;
    EPwm1Regs.TBCTL.bit.CLKDIV = 0;

    EPwm1Regs.ETSEL.bit.SOCAEN = 1;
    EPwm1Regs.ETSEL.bit.SOCASEL = 1;     // CTR=ZERO
    EPwm1Regs.ETPS.bit.SOCAPRD = 1;

    EDIS;
}

/* ---------------- ADC ---------------- */
interrupt void adca_isr(void)
{
    adcBuffer[sampleIndex] = AdcaResultRegs.ADCRESULT0;
    sampleIndex++;

    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;
    PieCtrlRegs.PIEACK.all = 1;

    if (sampleIndex >= CAPTURE_SAMPLES)
    {
        EPwm1Regs.ETSEL.bit.SOCAEN = 0;
        capture_done = 1;
    }
}

void initADC(void)
{
    EALLOW;

    AdcaRegs.ADCCTL2.bit.PRESCALE = 6;
    AdcSetMode(ADC_ADCA, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);
    AdcaRegs.ADCCTL1.bit.INTPULSEPOS = 1;
    AdcaRegs.ADCCTL1.bit.ADCPWDNZ = 1;
    DELAY_US(1000);

    /* SOC0 */
    AdcaRegs.ADCSOC0CTL.bit.CHSEL = ADC_CHANNEL;
    AdcaRegs.ADCSOC0CTL.bit.ACQPS = ADC_SOC_ACQPS;
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = 5;   // ePWM1 SOCA

    /* Interrupt on EOC0 */
    AdcaRegs.ADCINTSEL1N2.bit.INT1SEL = 0;
    AdcaRegs.ADCINTSEL1N2.bit.INT1E = 1;
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

    /* ISR binding */
    PieVectTable.ADCA1_INT = &adca_isr;

    /* Enable PIE and CPU interrupts (NO IER USE) */
    PieCtrlRegs.PIEIER1.bit.INTx1 = 1;
    EDIS;
}

/* ------------ MAIN ------------ */
int main(void)
{
#ifdef _FLASH
    memcpy(&RamfuncsRunStart, &RamfuncsLoadStart, (size_t)&RamfuncsLoadSize);
#endif

    InitSysCtrl();
    DINT;
    InitPieCtrl();
    InitPieVectTable();

    /* Enable EPWM clock and stop TBCLK */
    EALLOW;
    CpuSysRegs.PCLKCR2.bit.EPWM1 = 1;
    CpuSysRegs.PCLKCR0.bit.TBCLKSYNC = 0;
    EDIS;

    initSCIA();

    /* announce */
    {
        const char *t = "CAPTURE_STARTED\n";
        while (*t) scia_send_byte((unsigned char)*t++);
    }

    /* LED output */
    EALLOW;
    GpioCtrlRegs.GPADIR.bit.GPIO31 = 1;
    GpioDataRegs.GPASET.bit.GPIO31 = 1;
    EDIS;

    initEPWM1();
    initADC();

    /* Start TBCLK now */
    EALLOW;
    CpuSysRegs.PCLKCR0.bit.TBCLKSYNC = 1;
    EDIS;

    sampleIndex = 0;
    capture_done = 0;

    EINT;       // global enable
    ERTM;

    /* wait for ISR to fill buffer */
    while (!capture_done) asm(" NOP");

    /* Dump */
    {
        const char *h = "CAPTURE_DONE\n";
        while (*h) scia_send_byte((unsigned char)*h++);
    }

    /* binary dump */
    {
        uint16_t i;
        for (i = 0; i < CAPTURE_SAMPLES; i++)
        {
            uint16_t v = adcBuffer[i];
            scia_send_byte((unsigned char)(v & 0xFF));
            scia_send_byte((unsigned char)(v >> 8));
        }
    }

    {
        const char *f = "\nCAPTURE_END\n";
        while (*f) scia_send_byte((unsigned char)*f++);
    }

    while (1) asm(" NOP");
}
